    },
    "example": {
      "spec": "example-spec.json",
      "apiBaseUrl": "https://api.example.com",
      "auth": "none (sample spec; api.example.com is not a live backend)",
      "headersEnv": null
    }
  },
  "excluded": {
    "Authorization_v2.json": "NOT an OpenAPI document - the file is a saved Optum Developer Portal HTML page (starts with <!DOCTYPE html>). Re-download the raw JSON spec from the Optum portal to include it.",
    "Telnyx.yml": "byte-for-byte same API as Telnyx.json (same title/version/838 operations); JSON variant used.",
    "example-spec.yaml": "same sample API as example-spec.json; JSON variant used."
  }
}
