      "headersEnv": "Authorization:Bearer ${PERPLEXITY_API_KEY}"
    },
    "perplexity-async-create": {
      "spec": "asyncCompletions.yml",
      "apiBaseUrl": "https://api.perplexity.ai",
      "auth": "bearer (PERPLEXITY_API_KEY)",
      "headersEnv": "Authorization:Bearer ${PERPLEXITY_API_KEY}"
    },
    "perplexity-async-get": {
      "spec": "getasyncCompletions.yml",
      "apiBaseUrl": "https://api.perplexity.ai",
      "auth": "bearer (PERPLEXITY_API_KEY)",
      "headersEnv": "Authorization:Bearer ${PERPLEXITY_API_KEY}"
    },
    "perplexity-async-list": {
      "spec": "listasyncCompletions.yml",
      "apiBaseUrl": "https://api.perplexity.ai",
      "auth": "bearer (PERPLEXITY_API_KEY)",
      "headersEnv": "Authorization:Bearer ${PERPLEXITY_API_KEY}"
    },
    "perplexity-agentic-research": {
      "spec": "agenticResearch.yml",
