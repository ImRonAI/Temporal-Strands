{
  "mcpServers": {
    "agent-sops": {
      "command": ".venv/bin/strands-agents-sops",
      "args": ["mcp", "--sop-paths", "sops"]
    },
    "shell": {
      "command": ".venv/bin/strands-shell",
      "args": ["--mcp"]
    },
    "datacommons": {
      "url": "${DATACOMMONS_MCP_URL}",
      "headers": {
        "X-API-Key": "${DC_API_KEY}"
      },
      "continue_on_error": true
    },
    "pophive": {
      "url": "${POPHIVE_MCP_URL}",
      "continue_on_error": true
    },
    "telnyx": {
      "url": "https://api.telnyx.com/v2/mcp",
      "headers": {"Authorization": "Bearer ${TELNYX_API_KEY}"},
      "continue_on_error": true
    },
    "telnyx-readonly": {
      "url": "https://api.telnyx.com/v2/ai/mcp",
      "continue_on_error": true
    },
    "telnyx-docs": {
      "url": "https://developers.telnyx.com/mcp",
      "continue_on_error": true
    },
    "cms-coverage": {
      "command": "uvx",
      "args": ["--from", "openapi-mcp-server", "openapi_mcp_server", "--openapi-spec-path", "cms-coverage-mcp-server/coverageapi.json", "--api-base-url", "https://api.cms.gov/mcd"],
      "continue_on_error": true
    },
    "openapi": {
      "command": "npx",
      "args": ["-y", "@ivotoby/openapi-mcp-server"],
      "env": {"API_BASE_URL": "", "OPENAPI_SPEC_PATH": ""},
      "continue_on_error": true
    },
    "unsloth": {
      "command": "npm",
      "args": ["--prefix", "unsloth-mcp-server", "run", "start"],
      "continue_on_error": true
    },
    "mcp-installer": {
      "command": "npx",
      "args": ["@anaisbetts/mcp-installer"],
      "continue_on_error": true
    }
  },
  "openapiSchemas": [
    {"name": "telnyx", "path": "Telnyx.yml"},
    {"name": "calendar", "path": "calendar.json"},
    {"name": "teamChat", "path": "teamChat.json"},
    {"name": "zoom_meetings", "path": "zoom_meetings.json"},
    {"name": "apiguru", "path": "apiguru.yml"},
    {"name": "searchAPI", "path": "searchAPI.yml"},
    {"name": "cms-coverage", "path": "cms-coverage-mcp-server/coverageapi.json"},
    {"name": "openapi-example", "path": "openapi-mcp/example-spec.yaml"}
  ]
}
