data: {"perplexity": {"item": {"call_id": "call_zIs35khMpON83X39mqkZTOMl", "code": "import pplx_sdk, asyncio, json\nasync def main():\n    client = pplx_sdk.AsyncPplxClient()\n    print(json.dumps({\"search_type\": type(client.search).__name__, \"methods\": [n for n in dir(client.search) if not n.startswith(\"_\")]}))\n    await client.close()\nasyncio.run(main())", "container_id": "01a0cb49-7be4-77e8-81cd-f8f6890f12c3", "language": "python", "results": [{"duration_ms": 3306, "exit_code": 0, "status": "completed", "stderr": "", "stdout": "{\"search_type\": \"AsyncSearchResource\", \"methods\": [\"academic\", \"companies\", \"images\", \"local\", \"patents\", \"people\", \"secgov\", \"shopping\", \"videos\", \"web\"]}\n"}], "status": "completed", "type": "sandbox_results"}, "output_index": 12, "sequence_number": 39, "type": "response.output_item.done"}, "topic": "events"}

