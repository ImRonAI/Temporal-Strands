data: {"perplexity": {"item": {"call_id": "call_awqBpwfpR1to6EPznCtp94gZ", "code": "from perplexity import Perplexity\n\nclient = Perplexity()\nresult = client.search.create(\n    query=\"head of engineering Temporal Technologies\",\n    search_type=\"people\",\n    max_results=3,\n)\nprint(result.model_dump_json())", "container_id": "01a0cb49-7be4-77e8-81cd-f8f6890f12c3", "language": "python", "results": [{"duration_ms": 3413, "exit_code": 1, "status": "completed", "stderr": "Traceback (most recent call last):\n  File \"<stdin>\", line 3, in <module>\n  File \"/home/user/.local/lib/python3.14/site-packages/perplexity/_client.py\", line 92, in __init__\n    raise PerplexityError(\n        \"The api_key client option must be set either by passing api_key to the client or by setting the PERPLEXITY_API_KEY environment variable\"\n    )\nperplexity.PerplexityError: The api_key client option must be set either by passing api_key to the client or by setting the PERPLEXITY_API_KEY environment variable\n", "stdout": ""}], "status": "completed", "type": "sandbox_results"}, "output_index": 16, "sequence_number": 51, "type": "response.output_item.done"}, "topic": "events"}

data: {"perplexity": {"item": {"call_id": "call_RJVLukxRwcnZ8lMseQbuou8q", "code": "import os\nfrom perplexity import Perplexity\n\nclient = Perplexity(api_key=os.environ.get(\"PPLX_SDK_API_KEY\"))\nresult = client.search.create(\n    query=\"head of engineering Temporal Technologies\",\n    search_type=\"people\",\n    max_results=3,\n)\nprint(result.model_dump_json())", "container_id": "01a0cb49-7be4-77e8-81cd-f8f6890f12c3", "language": "python", "results": [{"duration_ms": 5160, "exit_code": 1, "status": "completed", "stderr": "Traceback (most recent call last):\n  File \"<stdin>\", line 5, in <module>\n  File \"/home/user/.local/lib/python3.14/site-packages/perplexity/generated/api.py\", line 3911, in create\n    self._post(\n    ~~~~~~~~~~^\n        \"/search\",\n        ^^^^^^^^^^\n    ...<7 lines>...\n        ),\n        ^^\n    ),\n    ^\n  File \"/home/user/.local/lib/python3.14/site-packages/perplexity/_generated_transport.py\", line 85, in post\n    return self._request(self._client.post, path, options)\n           ~~~~~~~~~~~~~^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/home/user/.local/lib/python3.14/site-packages/perplexity/_generated_transport.py\", line 76, in _request\n    return request()\n  File \"/home/user/.local/lib/python3.14/site-packages/perplexity/_generated_transport.py\", line 71, in request\n    return method(path, **transport_options, options=nested_options)\n  File \"/home/user/.local/lib/python3.14/site-packages/perplexity/_base_client.py\", line 1284, in post\n    return cast(ResponseT, self.request(cast_to, opts, stream=stream, stream_cls=stream_cls))\n                           ~~~~~~~~~~~~^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/home/user/.local/lib/python3.14/site-packages/perplexity/_base_client.py\", line 1071, in request\n    raise self._make_status_error_from_response(err.response) from None\nperplexity.AuthenticationError: Error code: 401 - {'error': {'message': 'Invalid API key provided. You can find your API key at https://console.perplexity.ai.', 'type': 'invalid_api_key', 'code': 401}}\n", "stdout": ""}], "status": "completed", "type": "sandbox_results"}, "output_index": 17, "sequence_number": 54, "type": "response.output_item.done"}, "topic": "events"}

data: {"perplexity": {"item": {"call_id": "call_qQEpmkbB52ttmeHEaSAxMRGu", "code": "import pplx_sdk\nfrom pydantic import RootModel\n\nclass SearchResponse(RootModel[list[dict]]):\n    pass\n\nclass SearchResource:\n    def create(self, *, query, search_type, max_results):\n        if search_type != \"people\":\n            raise ValueError(\"This adapter only supports people search\")\n        hits = pplx_sdk.search.people(query, limit=max_results)\n        return SearchResponse([dict(hit) for hit in hits])\n\nclass Client:\n    search = SearchResource()\n\nclient = Client()\nresult = client.search.create(\n    query=\"head of engineering Temporal Technologies\",\n    search_type=\"people\",\n    max_results=3,\n)\nprint(result.model_dump_json())", "container_id": "01a0cb49-7be4-77e8-81cd-f8f6890f12c3", "language": "python", "results": [{"duration_ms": 7755, "exit_code": 0, "status": "completed", "stderr": "", "stdout": "[{\"url\":\"https://temporal.io/careers/8a65908d-4f38-4b19-a0ed-453904180469\",\"title\":\"Head of Engineering, Compute - Temporal\",\"summary\":\"# Head of Engineering, Compute\\n...\\nThe Compute team owns the layer all of that runs on.\\nWe are looking for a Head of Engineering to lead the effort to make any aspects of Temporal's compute invisible to our customers, allowing them to focus on application layer innovation, while we handle the compute muck.\\nThis is a rare, build-the-foundation mandate: the compute substrate that the world's most demanding AI workloads will run on.\\nWe want a leader who has operated compute at planet scale, thinks in fleets, goodput, and cost-per-unit-of-compute, and pairs that with the operational rigor to run a service that frontier-AI companies bet production on.\\n## What You'll Do\\n- **Strategic direction for Compute:** Own the strategy and standards of excellence for the compute layer that the world's agents run on, across design, delivery, and operations.\\nBuild a culture of ownership, quality, and customer-first decision-making.\\n- **Technical leadership:** Lead, hire, and grow a high-ownership team; roll up sleeves, ready to do deep into the trenches, by staying close to design docs and code, rather than managing from a distance.\\nCoach engineers, level them up, and clear the friction that slows them down.\\n...\\n- **Technical depth:** Guide the hard architectural decisions for large-scale, multi-tenant compute, where technical concerns cut across workload isolation and security, scheduling, fleet efficiency / utilization / goodput, and performance, while ensuring the platform is reliable and efficient for the workloads that depend on it.\\n- **Capacity, supply & economics:** Own utilization, capacity and supply planning, and the cost-per-unit-of-compute and margin profile of the fleet, across CPU compute today and accelerated compute ahead.\\n...\\n## What You'll Bring\\n- Proven experience leading software engineering teams that build and operate large-scale compute platforms or fleets, with strong operational practices.\\n- 15+ years in software and/or infrastructure engineering, including 10+ years of people management and demonstrated ownership of delivery and live-site outcomes.\\n- Deep distributed-systems and compute infrastructure depth, with the hands-on judgment to guide architecture and execution rather than from a distance.\\n- Experience operating multi-tenant compute that other people's production workloads depend on.\\n- Bachelor's degree in Computer Science or related field, or equivalent practical experience; advanced degree a plus.\\n- Excellent communication skills, with the ability to partner across engineering, product, and leadership and fold customer feedback into the roadmap.\\n- Strong leadership, coaching, and performance management; ability to grow engineers and build a healthy, accountable, high-ownership team.\\n- Excellence in execution: planning, prioritization, and delivering iterative milestones in an ambiguous, fast-moving environment while managing unplanned work.\\n- Fleet thinking: utilization, goodput, capacity and supply planning, and cost discipline as first-class engineering concerns.\\n- Live-site reliability craft: on-call, incident management & response, and postmortem-driven continuous improvement.\\n- Strong command of the building blocks of a compute platform: multi-tenant isolation and security, scheduling, and resource management.\\n- Ability to review and raise the bar on technical artifacts (design docs, code reviews) across a distributed-systems codebase.\\n...\\nThe ideal candidate is a strategic thinker with a hands-on approach, energized by building the compute foundation the AI era runs on.\\nThey are comfortable shaping a space that doesn't fully exist yet, obsessed with reliability when customers bet production on it, default to working backwards from customers, and balance the speed to ship 0-to-1 against the durable design a planet-scale platform demands.\\n...\\nTemporal is remote-first.\\nMost roles are remote in-country, some are remote within a region, and a few teams have an in-office hub.\\n...\\nA few quick questions.\"},{\"url\":\"https://www.linkedin.com/in/rohitbhushan\",\"title\":\"Rohit Gupta - Temporal Technologies - LinkedIn\",\"summary\":\"**Rohit Gupta**\\n**Director Of Engineering**\\n**Sr. Director of Engineering @ Temporal | Investor | Advisor**\\nSaratoga, California, United States\\n...\\n### Experience\\n- **Director Of Engineering**\\n**Temporal Technologies**\\nJuly 2021 - Present\\nSaratoga, California, United States\\n- **Head of Engineering | Advisor**\"},{\"url\":\"https://theorg.com/org/temporal-technologies/org-chart/rohit-gupta\",\"title\":\"Rohit Gupta - Director, Engineering at Temporal Technologies | The Org\",\"summary\":\"Rohit Gupta is currently the Director of Engineering at Temporal Technologies.\\n...\\nRohit Gupta works with Smitty Weygant - Director, Solutions Architecture, Steve Kinney - Head of Engineering, Frontend and Developer Tools, and Ryan Cox - Director, Engineering.\"}]\n"}], "status": "completed", "type": "sandbox_results"}, "output_index": 18, "sequence_number": 57, "type": "response.output_item.done"}, "topic": "events"}

