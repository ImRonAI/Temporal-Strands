data: {"messageStart": {"role": "assistant"}, "topic": "events"}

data: {"perplexity": {"item": {"id": "mcpl_5b20dcf2-c864-46ad-85e0-db9aaed84bb2", "server_label": "datacommons", "tools": [{"description": "CRITICAL: Before calling this tool for the first time in a session, you MUST read the playbook resource by calling your platform's standard MCP resource-reading capability for the URI 'skill://data-commons-researcher/SKILL.md'.\n\nSearch the Data Commons Knowledge Graph for topics and statistical variables (indicators) matching a natural language query. Returns candidate indicator DCIDs, names, and data availability mappings. Can be optionally scoped to a list of target places to verify data presence. \n", "input_schema": {"additionalProperties": false, "properties": {"include_topics": {"default": true, "type": "boolean"}, "per_search_limit": {"default": 10, "type": "integer"}, "places": {"anyOf": [{"items": {"type": "string"}, "type": "array"}, {"type": "null"}], "default": null}, "query": {"type": "string"}}, "required": ["query"], "type": "object"}, "name": "search_indicators"}, {"description": "CRITICAL: Before calling this tool for the first time in a session, you MUST read the playbook resource by calling your platform's standard MCP resource-reading capability for the URI 'skill://data-commons-child-places-researcher/SKILL.md'.\n\nSearch the Data Commons Knowledge Graph for statistical indicators available at the child-place level within a parent geographic entity. Returns candidate indicator DCIDs and child place data availability mappings. Requires providing a parent place and a diverse sample list of its child places to verify sub-national coverage.\n", "input_schema": {"additionalProperties": false, "properties": {"include_topics": {"default": true, "type": "boolean"}, "parent_place": {"type": "string"}, "per_search_limit": {"default": 10, "type": "integer"}, "query": {"type": "string"}, "sample_child_places": {"items": {"type": "string"}, "type": "array"}}, "required": ["query", "parent_place", "sample_child_places"], "type": "object"}, "name": "search_child_indicators"}, {"description": "Retrieve detailed structural metadata, including definitions, temporal coverage, and provenances, for a list of statistical variables. Returns a dictionary mapping variables to their source facets and entity coverages. Use this to assess and qualify variables before fetching heavy observation data.\n", "input_schema": {"additionalProperties": false, "properties": {"entity_dcids": {"items": {"type": "string"}, "type": "array"}, "variable_dcids": {"items": {"type": "string"}, "type": "array"}}, "required": ["variable_dcids", "entity_dcids"], "type": "object"}, "name": "get_variable_metadata"}, {"description": "Retrieve time-series numerical observations for a specific statistical variable at a target place. Returns an array of dated observation values and their source metadata. Operates in single-place mode; for child-level containment data, use get_child_observations.\n", "input_schema": {"additionalProperties": false, "properties": {"date": {"default": "latest", "type": "string"}, "date_range_end": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null}, "date_range_start": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null}, "place_dcid": {"type": "string"}, "source_override": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null}, "variable_dcid": {"type": "string"}}, "required": ["variable_dcid", "place_dcid"], "type": "object"}, "name": "get_observations"}, {"description": "Retrieve time-series numerical observations for a statistical variable across all child places of a specific type within a parent geographic entity. Returns an array of dated observation values for each child place and their source metadata. Requires specifying the child place type (e.g., 'County' or 'State') and a bounded date range or 'latest' filter to prevent payload saturation.\n", "input_schema": {"additionalProperties": false, "properties": {"child_place_type": {"type": "string"}, "date": {"default": "latest", "type": "string"}, "date_range_end": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null}, "date_range_start": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null}, "parent_place_dcid": {"type": "string"}, "source_override": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null}, "variable_dcid": {"type": "string"}}, "required": ["variable_dcid", "parent_place_dcid", "child_place_type"], "type": "object"}, "name": "get_child_observations"}], "type": "mcp_list_tools"}, "output_index": 0, "sequence_number": 4, "type": "response.output_item.done"}, "topic": "events"}

data: {"perplexity": {"item": {"id": "mcpl_a864ef0f-9305-4b32-8bb4-e6fc6da9e342", "server_label": "pophive", "tools": [{"description": "Cross-disease situation report for one US state or the nation \u2014 what's\nelevated, rising, declining, or stale across every PopHIVE topic. For\nstraightforward single-slice questions only (e.g. \"anything elevated\nin Connecticut?\", \"public health sitrep for Florida?\"). If the answer\nneeds anything beyond reading one precomputed evidence block, use\nget_data.\n\nExamples: \"What's going on health-wise in Texas?\", \"Public health sitrep\nfor Florida\", \"Anything elevated in Connecticut?\"\n\nNot for: a single disease (get_current_status), time series (get_trend),\nranking states by one disease (get_map).\n\nCall example: get_overview(geography='Texas')\n\n    Scope: US-only aggregate surveillance; relay the precomputed evidence, never re-derive numbers.", "input_schema": {"additionalProperties": false, "properties": {"diseases": {"anyOf": [{"items": {"type": "string"}, "type": "array"}, {"type": "null"}], "default": null, "description": "Optional list of topics to scope to; default all.\nget_data() lists topics."}, "geography": {"default": "US", "description": "A US state (\"Connecticut\", \"CT\"), DC, or a territory\n(PR, GU, VI, AS, MP); omit for national. No counties (most\ntopics are state-level).", "type": "string"}, "include_chart": {"default": true, "description": "Attach a sparkline grid (one mini chart per topic).", "type": "boolean"}}, "type": "object"}, "name": "get_overview"}, {"description": "Current-status verdict for one disease in one US place \u2014 level,\ndirection, and risk right now. For straightforward single-slice\nquestions only (e.g. \"is flu rising in Texas?\", \"how bad is COVID\nnationally?\"). If the answer needs anything beyond reading one\nprecomputed evidence block, use get_data.\n\nExamples: \"Is RSV rising in Connecticut?\", \"How bad is flu nationally?\",\n\"What is the risk of measles in Texas?\", \"Current COVID situation in\nNew York.\"\n\nNot for: trends over time (get_trend), ranking geographies (get_map),\nvaccination coverage (get_coverage).\n\nCall example: get_current_status(disease='rsv', geography='Connecticut')\n\n    Scope: US-only aggregate surveillance; relay the precomputed evidence, never re-derive numbers.", "input_schema": {"additionalProperties": false, "properties": {"disease": {"description": "Any PopHIVE topic or alias (e.g. \"flu\", \"covid\", \"measles\").\nget_data() lists all topics.", "type": "string"}, "geography": {"default": "US", "description": "A state, county, or city \u2014 e.g. \"CT\", \"New Haven County,\nCT\", \"Houston\" (same grammar as get_trend); omit for national.", "type": "string"}, "include_chart": {"default": true, "description": "Attach a PNG of all sources' recent trends.", "type": "boolean"}, "include_query": {"default": false, "description": "Include a runnable pandas snippet + column schema.", "type": "boolean"}, "source": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "Pin the headline to one source by name \u2014 e.g.\n\"hospitalizations\" when the user asks about hospital admissions\nrather than the default ED-visit signal. Omit for the preferred\nsignal; errors list valid names."}}, "required": ["disease"], "type": "object"}, "name": "get_current_status"}, {"description": "Trend over time for one disease in one US place \u2014 direction, peak, and\nchange, optionally stratified or pinned to one source. For\nstraightforward single-slice questions only (e.g. \"how has RSV changed\nsince January?\", \"flu trend in Ohio\"). If the answer needs anything\nbeyond reading one precomputed evidence block, use get_data.\n\nExamples: \"What are the latest trends in COVID?\", \"How has flu changed\nsince January?\", \"Diabetes trend in Ohio over 5 years.\"\n\nseason_over_season evidence compares the current season to the\nimmediately prior season only; for older seasons use get_data.\n\nNot for: a current-status verdict (get_current_status), ranking\ngeographies (get_map), vaccination coverage (get_coverage).\n\nCall example: get_trend(disease='flu', geography='US', period='12w')\n\n    Scope: US-only aggregate surveillance; relay the precomputed evidence, never re-derive numbers.", "input_schema": {"additionalProperties": false, "properties": {"baseline": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "Anchor the Change block to an explicit baseline instead of\nthe default recent window \u2014 a 4-digit year (\"2020\") or ISO date\n(\"2020-03-01\"). Answers \"how has X changed since 2020?\" with\nfrom_value at the baseline and to_value at the latest observation."}, "disease": {"description": "Any PopHIVE topic or alias (e.g. \"flu\", \"covid\", \"measles\").\nget_data() lists all topics.", "type": "string"}, "geography": {"default": "US", "description": "a US state (\"Connecticut\", \"CT\"), DC, a US territory (PR, GU, VI, AS, MP), a county (\"New Haven County, CT\", \"09009\"), a major US city (\"Houston\"), or \"US\" for national. Default \"US\".", "type": "string"}, "include_chart": {"default": true, "description": "Attach a PNG line chart.", "type": "boolean"}, "include_query": {"default": false, "description": "Include a runnable pandas snippet + column schema.", "type": "boolean"}, "period": {"default": "12w", "description": "\"1w\", \"2w\", \"4w\", \"8w\", \"12w\" (default), \"season\", \"1y\", \"2y\",\n\"3y\", \"5y\", or \"all\". Use \"1w\" for week-over-week change. Periods\nshorter than the dataset's cadence are rejected; periods longer\nthan available history echo the actual span in\n``resolved.period_actual``.", "type": "string"}, "source": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "Pin to one upstream signal. Friendly names accepted (\"Epic\nCosmos\", \"wastewater\", \"hospitalizations\"). When omitted, uses\nPopHIVE's preferred trend signal for this disease and\ncross-validates against the others \u2014 the answer states which\nsignal the series is from and whether the others agree. Never\ndescribe a single signal as \"the\" number for the disease."}, "stratify_by": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "Break out by a stratification dimension (one of\n\"age\", \"alph_type\", \"antibiotic\", \"antimicrobial\", \"cause_of_death\", \"emm_type\", \"ethnicity\", \"forecast_day\", \"genus_species_serotype\", \"insurance\", \"measure\", \"onset\", \"outcome_name\", \"pathogen\", \"pattern\", \"race\", \"race_ethnicity\", \"serotype\", \"sex\", \"syndrome\", \"urban\", \"vaccine\", \"vax\", \"vax_group\" \u2014 varies by disease; get_data(disease=X) lists which\napply)."}, "stratum": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "With stratify_by, pin the series to ONE value of that\ndimension instead of breaking out all of them \u2014 e.g.\nstratify_by=\"age\", stratum=\"0-4 years\" for a pediatric series, or\nstratify_by=\"insurance\", stratum=\"Medicaid\". Case-insensitive;\nwhole-word matches and common aliases (AIAN, Pacific Islander)\naccepted. A value carried by a sibling signal of the same topic\nis routed to it automatically. Errors list the valid values."}}, "required": ["disease"], "type": "object"}, "name": "get_trend"}, {"description": "Geographic ranking \u2014 which US states or counties are highest or lowest\non one disease, by current level or recent change. For straightforward\nsingle-slice questions only (e.g. \"which counties have the highest\nRSV?\", \"how does Texas rank on flu?\"). If the answer needs anything\nbeyond reading one precomputed evidence block, use get_data.\n\nExamples: \"What parts of the US have the highest rates of flu right\nnow?\", \"How do diabetes rates differ across the US by county?\", \"How\ndoes Texas rank?\", \"Which states are improving fastest on opioid\noverdose?\"\n\nNot for: trends over time (get_trend), one place's status\n(get_current_status).\n\nCall example: get_map(disease='flu', geo_level='state', top_n=10)\n\n    Scope: US-only aggregate surveillance; relay the precomputed evidence, never re-derive numbers.", "input_schema": {"additionalProperties": false, "properties": {"direction": {"default": "highest", "description": "\"highest\" (default) or \"lowest\".", "type": "string"}, "disease": {"description": "Any PopHIVE topic or alias (e.g. \"flu\", \"covid\", \"mmr\").\nget_data() lists all topics.", "type": "string"}, "geo_level": {"default": "state", "description": "\"state\" (default) or \"county\".", "type": "string"}, "highlight": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "Optional geography to locate in the ranking. The answer\nstates its exact rank, value, and quartile so you never have to\ninfer it from the top-N alone."}, "include_chart": {"default": true, "description": "Attach a PNG bar chart.", "type": "boolean"}, "include_query": {"default": false, "description": "Include a runnable pandas snippet + column schema.", "type": "boolean"}, "rank_by": {"default": "value", "description": "\"value\" (default) ranks by current level. \"change\" ranks by\nrecent trend direction/magnitude \u2014 direction=\"lowest\" then means\nfastest-declining (most improving for incidence measures),\n\"highest\" means fastest-rising. Each row carries from_value \u2192\nto_value + direction so you can quote \"WV: 51.4\u219245.5 (declining)\".", "enum": ["value", "change"], "type": "string"}, "region": {"anyOf": [{"type": "string"}, {"items": {"type": "string"}, "type": "array"}, {"type": "null"}], "default": null, "description": "Scope the ranking to part of the country \u2014 a region name\n(\"Northeast\", \"Midwest\", \"South\", \"West\", \"New England\",\n\"Pacific Northwest\", ...) or an explicit list of states\n([\"TX\", \"OK\", \"NM\"]). County rankings keep only counties in\nthose states. Ranks and medians are then within-region."}, "source": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "Pin one source by name; omit for the preferred source.\nErrors list valid names."}, "top_n": {"default": 10, "description": "1\u201320. Default 10.", "type": "integer"}}, "required": ["disease"], "type": "object"}, "name": "get_map"}, {"description": "Side-by-side comparison of one disease across 2\u20135 US places, or\nagreement between surveillance sources in one place. For\nstraightforward single-slice questions only (e.g. \"is RSV worse in CT\nthan NY?\", \"do wastewater and ED visits agree on COVID?\"). If the\nanswer needs anything beyond reading one precomputed evidence block,\nuse get_data.\n\nExamples: \"Is RSV worse in CT than NY?\", \"Compare diabetes in Texas vs\nCalifornia\", \"Do wastewater and ED visits agree on COVID?\"\n\nNot for: one place's status (get_current_status), ranking many places\n(get_map).\n\nCall example: compare(disease='covid', geographies=['Texas', 'Florida'])\n\n    Scope: US-only aggregate surveillance; relay the precomputed evidence, never re-derive numbers.", "input_schema": {"additionalProperties": false, "properties": {"disease": {"description": "Any PopHIVE topic or alias (e.g. \"flu\", \"covid\", \"measles\").\nget_data() lists all topics.", "type": "string"}, "geographies": {"anyOf": [{"items": {"type": "string"}, "type": "array"}, {"type": "null"}], "default": null, "description": "List of 2\u20135 geographies to compare side by side. If \"US\"\n(national) is one of them, every other geography gets a precomputed\nvs-national column (% above/below, or percentage-points for percent\nmeasures) so you can quote \"WV is 85% above national\" directly."}, "geography": {"default": "US", "description": "In sources mode, the place to correlate within \u2014 state,\ncounty, or city (same grammar as get_trend); omit for national.", "type": "string"}, "include_chart": {"default": true, "type": "boolean"}, "include_query": {"default": false, "description": "Include a runnable pandas snippet + column schema.", "type": "boolean"}, "period": {"default": "12w", "description": "\"4w\", \"8w\", \"12w\" (default), \"season\", \"1y\", \"all\".", "type": "string"}, "source": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "In geographies mode, pin one source by name; omit for the\npreferred source. Errors list valid names."}, "sources": {"anyOf": [{"items": {"type": "string"}, "type": "array"}, {"type": "null"}], "default": null, "description": "List of 2\u20135 source names to correlate within one geography."}}, "required": ["disease"], "type": "object"}, "name": "compare"}, {"description": "US childhood vaccination coverage \u2014 the rate for one vaccine in one\nplace and whether it meets targets. For straightforward single-slice\nquestions only (e.g. \"kindergarten MMR rate in Idaho?\", \"is Texas\nbelow 95% MMR?\"). If the answer needs anything beyond reading one\nprecomputed evidence block, use get_data.\n\nExamples: \"Kindergarten MMR rate in Idaho?\", \"Is Texas below 95% MMR?\",\n\"Polio vaccination rate in Connecticut.\"\n\nNot for: disease activity (get_current_status), trends (get_trend),\ncoverage rankings across states (get_map with disease='mmr').\n\nCall example: get_coverage(vaccine='mmr', geography='Idaho')\n\n    Scope: US-only aggregate surveillance; relay the precomputed evidence, never re-derive numbers.", "input_schema": {"additionalProperties": false, "properties": {"geo_level": {"default": "state", "description": "\"state\" (default) or \"county\" (MMR only).", "type": "string"}, "geography": {"default": "US", "description": "A state, county, or city \u2014 e.g. \"ID\", \"New Haven County,\nCT\", \"Houston\" (same grammar as get_trend); omit for national.", "type": "string"}, "include_chart": {"default": true, "type": "boolean"}, "include_query": {"default": false, "description": "Include a runnable pandas snippet + column schema.", "type": "boolean"}, "vaccine": {"default": "mmr", "description": "One of: combined7, dtap, hepa, hepb, hib, mmr, pcv, polio, rotavirus, vaccine_exemptions, varicella. Aliases like \"measles\" or \"chickenpox\"\nalso work. Default \"mmr\".", "type": "string"}}, "type": "object"}, "name": "get_coverage"}, {"description": "Data catalog and raw-data gateway. The six specialized tools answer\nsingle-slice questions \u2014 current status, trend, map/ranking, A-vs-B\ncompare, coverage \u2014 with server-verified evidence; try them first,\nescalating here costs one call. Use get_data when evidence can't carry\nthe answer: multi-stratum gaps, history beyond the served window,\ncomplete lists, cross-dataset joins, custom math. Flow: (1) catalog,\n(2) disease='about' for the guide, (3) view schema + data_url,\n(4) download and compute \u2014 results are yours but carry the caveats and\naren't server-verified. include_query=true returns a runnable pandas\nsnippet.\n\nTopics: annual_wellness_visit, antimicrobial_resistance, babesiosis, breast_cancer_screening, campylobacter, cardiovascular_screening, census, cervical_cancer_screening, chlamydia_screening, colorectal_cancer_screening, combined7, community_health, copd, covid19, dengue, depression_screening, diabetes, diabetes_screening, diarrhea, dtap, ehrlichiosis, enteric_disease, firearm_injury, flu_vaccine_adult, haemophilus_influenzae, healthcare_access, heat_illness, hepa, hepb, hib, infant_mortality, influenza, injury_deaths, low_birth_weight, malaria, maternal_health, maternal_mortality, measles, mmr, obesity, opioid_overdose, opioid_use_disorder, pcv, pelvic_exam, pertussis, pneumococcal_vaccine_adult, polio, prostate_cancer_screening, rotavirus, rsv, salmonella, shigella, stec, strep, teen_births, vaccine_exemptions, varicella, vector_borne, west_nile, youth_wellbeing.\n\nExamples: \"What does PopHIVE track?\", \"Do you have Lyme disease data?\",\n\"Vaccination gaps across insurance types\", \"Raw RSV data for\nConnecticut.\"\n\nNot for: 'is flu rising in Texas?' \u2192 get_current_status; 'rank states\nby COVID wastewater' \u2192 get_map; 'is RSV worse in CT than NY?' \u2192 compare.\n\nCall example: get_data(disease='rsv', view='overall_trend')\n\n    Scope: US-only aggregate surveillance; relay the precomputed evidence, never re-derive numbers.", "input_schema": {"additionalProperties": false, "properties": {"disease": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "Optional. If omitted, returns the full catalog inventory.\nPass \"about\" for the long-form reference document, \"archive\" for\nthe index of upstream source files (longer history, unserved\nmeasures; download-and-compute only; add view='<category>' for\none group's files)."}, "geography": {"anyOf": [{"type": "string"}, {"items": {"type": "string"}, "type": "array"}, {"type": "null"}], "default": null, "description": "Optional, only with disease+view. A single geography\n(\"CT\"), a list ([\"CT\", \"NY\", \"MA\"]), or \"all states\" for one\nlatest-period row per state."}, "include_query": {"default": false, "description": "Include a runnable pandas snippet + column schema.", "type": "boolean"}, "source": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "Optional. With no disease, returns the inverse lookup \u2014 every\ndisease that source covers (\"What does Epic Cosmos track?\").\nFriendly names accepted (\"wastewater\", \"google\")."}, "view": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "Optional. e.g. \"overall_trend\", \"geography_map\", \"trends_by_age\"."}}, "type": "object"}, "name": "get_data"}], "type": "mcp_list_tools"}, "output_index": 1, "sequence_number": 6, "type": "response.output_item.done"}, "topic": "events"}

data: {"perplexity": {"item": {"connector_id": "connector_linear", "id": "mcpl_4e963bad-6ca5-4341-9288-be0da7c80827", "server_label": "linear", "tools": [{"description": "Retrieve an issue attachment by ID. Use format=url to get its title and download URL without fetching the file content. Linear upload URLs are signed for five minutes; call again to refresh. External URLs are returned unchanged. Files embedded in comments have no issue attachment ID; use the URLs in list_comments attachments instead. Download and process documents with your own file tools.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"format": {"description": "Response format. Defaults to content.", "enum": ["content", "url"], "type": "string"}, "id": {"description": "Attachment ID", "type": "string"}}, "required": ["id"], "type": "object"}, "name": "get_attachment"}, {"description": "Prepare a direct Linear file upload for an existing issue.\n\nWorkflow:\n1. Call this tool with issue, filename, contentType, and size.\n2. Upload raw bytes with PUT to uploadRequest.url outside MCP.\n3. All headers in uploadRequest.headers are part of the signed request, so send them verbatim.\n4. After PUT succeeds, call create_attachment_from_upload with assetUrl to link it to the issue.\n\nDo not base64-encode or transform the file. Use curl --data-binary @path or fetch(url, { method: 'PUT', body: blob }).\nOmitting or modifying any signed header, including casing, will return HTTP 403.\nThe signed URL must be used within 60 seconds or it will expire.\n\nUpload sequencing:\nPrepare, PUT, and finalize one file before calling this tool for another file.\nDo not batch multiple prepare_attachment_upload calls before starting the PUTs because earlier signed URLs can expire while later files are prepared.\n\nExample:\ncurl -X PUT --data-binary @file.png \\\n  -H \"content-type: image/png\" \\\n  -H \"x-goog-content-length-range: N,N\" \\\n  -H \"cache-control: public, max-age=31536000\" \\\n  -H 'Content-Disposition: attachment; filename=\"file.png\"' \\\n  \"<uploadRequest.url>\"", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"contentType": {"description": "MIME type, e.g. image/png or application/pdf", "type": "string"}, "filename": {"description": "Filename for the upload, e.g. screenshot.png", "type": "string"}, "issue": {"description": "Issue ID or identifier (e.g., LIN-123). P-prefixed identifiers (e.g., P-ENG-123) are projects, not issues", "type": "string"}, "size": {"description": "Exact file size in bytes. Must be smaller than 2 GB.", "exclusiveMinimum": 0, "maximum": 9007199254740991, "type": "integer"}, "subtitle": {"description": "Suggested attachment subtitle for the finalize step", "type": "string"}, "title": {"description": "Suggested attachment title for the finalize step", "type": "string"}}, "required": ["issue", "filename", "contentType", "size"], "type": "object"}, "name": "prepare_attachment_upload"}, {"description": "Link an already-uploaded Linear assetUrl to an existing issue as an attachment.\n\nUse this only after:\n1. prepare_attachment_upload returned an assetUrl and uploadRequest.\n2. The client successfully PUT raw file bytes to uploadRequest.url.\n\nThis tool does not upload file content. It only creates the Linear attachment row.\nIf the direct upload failed or the signed URL expired, rerun prepare_attachment_upload and upload again.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"assetUrl": {"description": "Linear upload assetUrl returned by prepare_attachment_upload", "format": "uri", "type": "string"}, "issue": {"description": "Issue ID or identifier (e.g., LIN-123). P-prefixed identifiers (e.g., P-ENG-123) are projects, not issues", "type": "string"}, "subtitle": {"description": "Optional attachment subtitle", "type": "string"}, "title": {"description": "Attachment title. Defaults to filename or asset URL", "type": "string"}}, "required": ["issue", "assetUrl"], "type": "object"}, "name": "create_attachment_from_upload"}, {"description": "Deprecated fallback for tiny files only. Accepts base64 file content, verifies SHA-256 checksum, and uploads it through the MCP worker.\nPrefer `prepare_attachment_upload` plus direct PUT plus `create_attachment_from_upload`.\n\nCRITICAL: Do not print base64Content and then copy it into this tool call.\nOpaque base64 copied through model-visible text is easy to corrupt.\n\nGenerate base64Content mechanically from the source bytes and pass it through a programmatic argument construction path whenever available. Before calling this tool, verify the values are consistent:\n\nUnix-like shells:\nfile=\"/path/to/file\"\nbase64Content=$(base64 < \"$file\" | tr -d '\\n\\r')\nsha256=$(shasum -a 256 \"$file\" | awk '{print $1}')\ndecodedSha256=$(printf '%s' \"$base64Content\" | base64 -d | shasum -a 256 | awk '{print $1}')\nsize=$(wc -c < \"$file\" | tr -d ' ') # optional; stat can also get file byte size\ndecodedSize=$(printf '%s' \"$base64Content\" | base64 -d | wc -c | tr -d ' ')\n\nPowerShell:\n$file = 'C:\\path\\to\\file'\n$bytes = [IO.File]::ReadAllBytes($file)\n$base64Content = [Convert]::ToBase64String($bytes)\n$sha256 = (Get-FileHash -Algorithm SHA256 -Path $file).Hash.ToLower()\n$size = $bytes.Length # optional\n$decoded = [Convert]::FromBase64String($base64Content)\n$decodedStream = [IO.MemoryStream]::new($decoded)\n$decodedSha256 = (Get-FileHash -Algorithm SHA256 -InputStream $decodedStream).Hash.ToLower()\n$decodedSize = $decoded.Length\n\ndecodedSha256 must equal sha256. If you pass size, decodedSize must equal size.\nPass `sha256`. Passing `size` is optional, but recommended for clearer mismatch errors.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"base64Content": {"description": "Deprecated base64-encoded file content to upload", "type": "string"}, "contentType": {"description": "MIME type for the upload (e.g., 'image/png', 'application/pdf')", "type": "string"}, "filename": {"description": "Filename for the upload (e.g., 'screenshot.png')", "type": "string"}, "issue": {"description": "Issue ID or identifier (e.g., LIN-123). P-prefixed identifiers (e.g., P-ENG-123) are projects, not issues", "type": "string"}, "sha256": {"description": "Expected SHA-256 hex digest of the decoded file bytes.", "pattern": "^[a-fA-F0-9]{64}$", "type": "string"}, "size": {"description": "Optional expected decoded file size in bytes. Rejects the upload if it does not match.", "exclusiveMinimum": 0, "maximum": 9007199254740991, "type": "integer"}, "subtitle": {"description": "Optional subtitle for the attachment", "type": "string"}, "title": {"description": "Optional title for the attachment", "type": "string"}}, "required": ["issue", "base64Content", "filename", "contentType", "sha256"], "type": "object"}, "name": "create_attachment"}, {"description": "Delete an attachment by ID", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"id": {"description": "Attachment ID", "type": "string"}}, "required": ["id"], "type": "object"}, "name": "delete_attachment"}, {"description": "List Linear Agent skills available to the authenticated user.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"cursor": {"description": "Next page cursor", "type": "string"}, "limit": {"default": 50, "description": "Max results (default 50, max 250)", "maximum": 250, "type": "number"}, "orderBy": {"default": "updatedAt", "description": "Sort: createdAt | updatedAt", "enum": ["createdAt", "updatedAt"], "type": "string"}}, "type": "object"}, "name": "list_agent_skills"}, {"description": "Retrieve a Linear Agent skill by ID, including its full markdown instructions.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"id": {"description": "Agent skill ID", "type": "string"}}, "required": ["id"], "type": "object"}, "name": "get_agent_skill"}, {"description": "List comments on a Linear issue, project, initiative, document, project milestone, or project/initiative status update. Provide exactly one of `issueId`, `projectId`, `initiativeId`, `documentId`, `milestoneId`, or `statusUpdateId`. For issues, projects, and initiatives this returns both top-level discussion threads and inline description comments. Inline (anchored) comments carry a non-null `quotedText` set to the snippet of description text they reference. Returned comments include `author` and nullable `onBehalfOf`; when set, `onBehalfOf` identifies the user the agent author acted for. Files uploaded in comment bodies are returned in `attachments` with titles and download URLs, not issue attachment IDs. Signed upload URLs expire after five minutes; call list_comments again to refresh them. Download documents using these URLs and process them with your own file tools.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"cursor": {"description": "Next page cursor", "type": "string"}, "documentId": {"description": "Document ID or slug (provide exactly one parent)", "type": "string"}, "initiativeId": {"description": "Initiative name, ID, identifier (e.g., I-123), or slug (provide exactly one parent)", "type": "string"}, "issueId": {"description": "Issue ID or identifier (e.g., LIN-123). P-prefixed identifiers (e.g., P-ENG-123) are projects, not issues (provide exactly one parent)", "type": "string"}, "limit": {"default": 50, "description": "Max results (default 50, max 250)", "maximum": 250, "type": "number"}, "milestoneId": {"description": "Milestone UUID (provide exactly one parent). Resolve milestone names via `list_milestones` first.", "type": "string"}, "orderBy": {"default": "updatedAt", "description": "Sort: createdAt | updatedAt", "enum": ["createdAt", "updatedAt"], "type": "string"}, "projectId": {"description": "Project name, ID, identifier (e.g., P-ENG-123), or slug (provide exactly one parent)", "type": "string"}, "statusUpdateId": {"description": "Status update UUID (provide exactly one parent). Resolve status updates via `get_status_updates` first.", "type": "string"}, "statusUpdateType": {"description": "Type of status update named by `statusUpdateId`, as returned by `get_status_updates`. Only valid together with `statusUpdateId`; omit to check both project and initiative status updates.", "enum": ["project", "initiative"], "type": "string"}}, "type": "object"}, "name": "list_comments"}, {"description": "Create or update a comment on a Linear issue, project, initiative, document, project milestone, or project/initiative status update. If `id` is provided, updates the existing comment; otherwise creates a new one. To start a new thread, pass `body` and exactly one of `issueId`, `projectId`, `initiativeId`, `documentId`, `milestoneId`, or `statusUpdateId` \u2014 comments on issues/projects/initiatives become top-level discussion threads; comments on documents/milestones become description comments. A status update holds a single thread, so a comment on an update that already has one is added to it as a reply. To reply to an existing thread, pass `parentId` and `body`; the reply inherits the parent's thread type, so no entity reference is needed. Parent reference fields are ignored when `id` or `parentId` is provided (`statusUpdateType` is rejected instead).", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"body": {"description": "Content as Markdown. Do not escape the string \u2014 use literal newlines and special characters, not escape sequences. To mention a user, use @displayName (e.g., @johndoe)", "type": "string"}, "documentId": {"description": "Document ID or slug (provide exactly one parent)", "type": "string"}, "id": {"description": "Comment ID. If provided, updates the existing comment", "type": "string"}, "initiativeId": {"description": "Initiative name, ID, identifier (e.g., I-123), or slug (provide exactly one parent)", "type": "string"}, "issueId": {"description": "Issue ID or identifier (e.g., LIN-123). P-prefixed identifiers (e.g., P-ENG-123) are projects, not issues (provide exactly one parent)", "type": "string"}, "milestoneId": {"description": "Milestone UUID (provide exactly one parent). Resolve milestone names via `list_milestones` first.", "type": "string"}, "parentId": {"description": "Parent comment ID (for replies, only when creating)", "type": "string"}, "projectId": {"description": "Project name, ID, identifier (e.g., P-ENG-123), or slug (provide exactly one parent)", "type": "string"}, "statusUpdateId": {"description": "Status update UUID (provide exactly one parent). Resolve status updates via `get_status_updates` first.", "type": "string"}, "statusUpdateType": {"description": "Type of status update named by `statusUpdateId`, as returned by `get_status_updates`. Only valid together with `statusUpdateId`; omit to check both project and initiative status updates.", "enum": ["project", "initiative"], "type": "string"}}, "required": ["body"], "type": "object"}, "name": "save_comment"}, {"description": "Delete a Linear comment. Inline description comments (those with non-null `quotedText`) anchor a mark in the editor, so their root cannot be deleted \u2014 delete the replies individually or resolve the thread instead.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"id": {"description": "Comment ID", "type": "string"}}, "required": ["id"], "type": "object"}, "name": "delete_comment"}, {"description": "Retrieve cycles for a specific Linear team", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"teamId": {"description": "Team ID", "type": "string"}, "type": {"description": "Filter: current, previous, next, or all", "enum": ["current", "previous", "next"], "type": "string"}}, "required": ["teamId"], "type": "object"}, "name": "list_cycles"}, {"description": "Find saved issue, project, and initiative views accessible to the user, including personal, workspace, and team views. Excludes archived views and views scoped to a project or initiative. Returns view metadata, not the records matching its filters.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"cursor": {"description": "Next page cursor", "type": "string"}, "limit": {"default": 50, "description": "Max results (default 50, max 250)", "maximum": 250, "type": "number"}, "orderBy": {"default": "updatedAt", "description": "Sort: createdAt | updatedAt", "enum": ["createdAt", "updatedAt"], "type": "string"}, "query": {"description": "Search custom view names", "type": "string"}, "shared": {"description": "True for shared views, false for personal views", "type": "boolean"}, "team": {"description": "Team name or ID", "type": "string"}, "type": {"description": "Entity type displayed by the view", "enum": ["Issue", "Project", "Initiative"], "type": "string"}}, "type": "object"}, "name": "list_custom_views"}, {"description": "Retrieve a Linear document by ID or slug", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"id": {"description": "Document ID or slug", "type": "string"}}, "required": ["id"], "type": "object"}, "name": "get_document"}, {"description": "List documents in the user's Linear workspace", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"createdAt": {"description": "Created after: ISO-8601 date/duration (e.g., -P1D)", "type": "string"}, "creatorId": {"description": "Filter by creator ID", "type": "string"}, "cursor": {"description": "Next page cursor", "type": "string"}, "fields": {"description": "Fields to include in each result. `id` is always included. Omit or pass an empty array for the default response.", "items": {"enum": ["id", "title", "content", "url", "createdAt", "updatedAt", "archivedAt", "creator", "updatedBy", "project", "initiative", "team", "issue"], "type": "string"}, "type": "array"}, "includeArchived": {"default": false, "description": "Include archived items", "type": "boolean"}, "initiativeId": {"description": "Filter by initiative ID", "type": "string"}, "limit": {"default": 50, "description": "Max results (default 50, max 250)", "maximum": 250, "type": "number"}, "orderBy": {"default": "updatedAt", "description": "Sort: createdAt | updatedAt", "enum": ["createdAt", "updatedAt"], "type": "string"}, "projectId": {"description": "Filter by project ID", "type": "string"}, "query": {"description": "Search query", "type": "string"}, "teamId": {"description": "Filter by team ID", "type": "string"}, "updatedAt": {"description": "Updated after: ISO-8601 date/duration (e.g., -P1D)", "type": "string"}}, "type": "object"}, "name": "list_documents"}, {"description": "Extract and fetch images from markdown content. Use this to view screenshots, diagrams, or other images embedded in Linear issues, comments, or documents. Pass the markdown content (e.g., issue description) and receive the images as viewable data.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"markdown": {"description": "Markdown content containing image references (e.g., issue description, comment body)", "type": "string"}}, "required": ["markdown"], "type": "object"}, "name": "extract_images"}, {"description": "Retrieve detailed information about an issue by ID, including attachments, git branch name, and active Triage Intelligence suggestions when the issue is in triage", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"id": {"description": "Issue ID or identifier (e.g., LIN-123). P-prefixed identifiers (e.g., P-ENG-123) are projects, not issues", "type": "string"}, "includeCustomerNeeds": {"default": false, "description": "Include associated customer needs", "type": "boolean"}, "includeRelations": {"default": false, "description": "Include blocking/related/duplicate relations", "type": "boolean"}, "includeReleases": {"default": false, "description": "Include associated releases", "type": "boolean"}}, "required": ["id"], "type": "object"}, "name": "get_issue"}, {"description": "List issues in the user's Linear workspace, including active Triage Intelligence suggestions for issues in triage. For my issues, use \"me\" as the assignee. Use \"null\" for no assignee.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"assignee": {"description": "User ID, name, email, or \"me\"", "type": ["string", "null"]}, "createdAt": {"description": "Created after: ISO-8601 date/duration (e.g., -P1D)", "type": "string"}, "cursor": {"description": "Next page cursor", "type": "string"}, "customView": {"description": "Saved view ID, URL, slug, or exact name. Use list_custom_views to discover views. Applies saved filters and scope; other filters narrow the results. Uses list ordering, not saved display settings", "minLength": 1, "type": "string"}, "cycle": {"description": "Cycle name, number, or ID", "type": "string"}, "delegate": {"description": "Agent name or ID. When the user asks to delegate to \"Linear\" or \"the Linear agent\", this refers to the \"Linear\" app user specifically", "type": "string"}, "fields": {"description": "Fields to include in each result. `id` is always included. Omit or pass an empty array for the default response.", "items": {"enum": ["id", "uuid", "title", "description", "projectMilestone", "priority", "estimate", "url", "gitBranchName", "createdAt", "updatedAt", "archivedAt", "completedAt", "startedAt", "canceledAt", "startedTriageAt", "triagedAt", "dueDate", "slaStartedAt", "slaMediumRiskAt", "slaHighRiskAt", "slaBreachesAt", "slaType", "status", "statusType", "labels", "triageIntel", "createdBy", "createdById", "assignee", "assigneeId", "delegate", "delegateId", "project", "projectId", "parentId", "team", "teamId", "cycleId"], "type": "string"}, "type": "array"}, "includeArchived": {"default": false, "description": "Include archived items", "type": "boolean"}, "label": {"description": "Label name or ID", "type": "string"}, "limit": {"default": 50, "description": "Max results (default 50, max 250)", "maximum": 250, "type": "number"}, "orderBy": {"default": "updatedAt", "description": "Sort: createdAt | updatedAt", "enum": ["createdAt", "updatedAt"], "type": "string"}, "parentId": {"description": "Parent issue ID or identifier (e.g., LIN-123)", "type": "string"}, "priority": {"description": "0=None, 1=Urgent, 2=High, 3=Medium, 4=Low", "type": "number"}, "project": {"description": "Project name, ID, identifier (e.g., P-ENG-123), or slug", "type": "string"}, "query": {"description": "Search issue title or description. Cannot be combined with customView", "type": "string"}, "release": {"description": "Release ID or slug", "type": "string"}, "state": {"description": "State type, name, or ID", "type": "string"}, "team": {"description": "Team name or ID", "type": "string"}, "triagedAt": {"description": "Left triage after: ISO-8601 date/duration (e.g., -P1D). Issues still in triage have no triagedAt; list them with state \"triage\"", "type": "string"}, "updatedAt": {"description": "Updated after: ISO-8601 date/duration (e.g., -P1D)", "type": "string"}}, "type": "object"}, "name": "list_issues"}, {"description": "List available issue statuses in a Linear team", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"team": {"description": "Team name or ID", "type": "string"}}, "required": ["team"], "type": "object"}, "name": "list_issue_statuses"}, {"description": "Retrieve detailed information about an issue status in Linear by name or ID", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"id": {"description": "Status ID", "type": "string"}, "name": {"description": "Status name", "type": "string"}, "team": {"description": "Team name or ID", "type": "string"}}, "required": ["id", "name", "team"], "type": "object"}, "name": "get_issue_status"}, {"description": "List available issue labels in a Linear workspace or team. A retired label carries `retiredAt` and cannot be applied to new issues.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"cursor": {"description": "Next page cursor", "type": "string"}, "includeArchived": {"default": false, "description": "Include archived items", "type": "boolean"}, "includeGroups": {"default": false, "description": "Include label groups in the results, marked with `isGroup`. A group cannot be applied directly; retiring or restoring one cascades to its child labels", "type": "boolean"}, "limit": {"default": 50, "description": "Max results (default 50, max 250)", "maximum": 250, "type": "number"}, "name": {"description": "Filter by name", "type": "string"}, "orderBy": {"default": "updatedAt", "description": "Sort: createdAt | updatedAt", "enum": ["createdAt", "updatedAt"], "type": "string"}, "team": {"description": "Team name or ID", "type": "string"}}, "type": "object"}, "name": "list_issue_labels"}, {"description": "Create or update a Linear issue label. If `id` is provided, updates the existing label; otherwise creates a new one. When creating, `name` is required.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"color": {"description": "Hex color code", "type": "string"}, "description": {"description": "Label description. Null to clear it", "type": ["string", "null"]}, "groupType": {"description": "Selection mode for label groups. Defaults to singleSelect when creating; omit to keep it unchanged when updating", "enum": ["singleSelect", "multiSelect"], "type": "string"}, "id": {"description": "Label name or ID. If provided, updates the existing label", "type": "string"}, "isGroup": {"description": "Whether the label is a group", "type": "boolean"}, "name": {"description": "Label name (required when creating)", "type": "string"}, "parent": {"description": "Parent label group name or ID. Null to remove from its group", "type": ["string", "null"]}, "teamId": {"description": "Team UUID (omit for workspace label). When updating, only disambiguates `id` by name; a label's team cannot be changed", "type": "string"}}, "type": "object"}, "name": "save_issue_label"}, {"description": "Create a new Linear issue label. Deprecated: use `save_issue_label`, which can also update labels.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"color": {"description": "Hex color code", "type": "string"}, "description": {"description": "Label description", "type": "string"}, "isGroup": {"default": false, "description": "Whether the label is a group", "type": "boolean"}, "name": {"description": "Label name", "type": "string"}, "parent": {"description": "Parent label group name or ID", "type": "string"}, "teamId": {"description": "Team UUID (omit for workspace label)", "type": "string"}}, "required": ["name"], "type": "object"}, "name": "create_issue_label"}, {"description": "Retire a Linear issue label so it cannot be applied to new issues. The label stays visible on issues that already have it. Retiring a label group also retires its child labels. Undo with `restore_issue_label`.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"id": {"description": "Label or label group ID", "type": "string"}}, "required": ["id"], "type": "object"}, "name": "retire_issue_label"}, {"description": "Restore a retired Linear issue label, making it available for use on issues again. Restoring a label group also restores every child label, including any that were retired separately.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"id": {"description": "Label or label group ID", "type": "string"}}, "required": ["id"], "type": "object"}, "name": "restore_issue_label"}, {"description": "List projects in the user's Linear workspace", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"createdAt": {"description": "Created after: ISO-8601 date/duration (e.g., -P1D)", "type": "string"}, "cursor": {"description": "Next page cursor", "type": "string"}, "customView": {"description": "Saved view ID, URL, slug, or exact name. Use list_custom_views to discover views. Applies saved filters and scope; other filters narrow the results. Uses list ordering, not saved display settings", "minLength": 1, "type": "string"}, "fields": {"description": "Fields to include in each result. `id` is always included. Omit or pass an empty array for the default response.", "items": {"enum": ["id", "uuid", "name", "summary", "description", "url", "trashed", "createdAt", "updatedAt", "startedAt", "completedAt", "canceledAt", "startDate", "startDateResolution", "targetDate", "targetDateResolution", "priority", "sortOrder", "labels", "initiatives", "lead", "leadTeam", "status", "teams", "members", "milestones"], "type": "string"}, "type": "array"}, "includeArchived": {"default": false, "description": "Include archived items", "type": "boolean"}, "includeMembers": {"default": false, "description": "Include project members", "type": "boolean"}, "includeMilestones": {"default": false, "description": "Include milestones", "type": "boolean"}, "initiative": {"description": "Initiative name, ID, identifier (e.g., I-123), or slug", "type": "string"}, "label": {"description": "Label name or ID", "type": "string"}, "limit": {"default": 50, "description": "Max results (default 50, max 50)", "maximum": 50, "type": "number"}, "member": {"description": "User ID, name, email, or \"me\"", "type": "string"}, "orderBy": {"default": "updatedAt", "description": "Sort: createdAt | updatedAt", "enum": ["createdAt", "updatedAt"], "type": "string"}, "query": {"description": "Search project name", "type": "string"}, "state": {"description": "State type, name, or ID", "type": "string"}, "team": {"description": "Team name or ID", "type": "string"}, "updatedAt": {"description": "Updated after: ISO-8601 date/duration (e.g., -P1D)", "type": "string"}}, "type": "object"}, "name": "list_projects"}, {"description": "Retrieve details of a specific project in Linear", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"customerNeedsCursor": {"description": "Next customer-needs page: pass customerNeedsPageInfo.endCursor with includeCustomerNeeds true", "type": "string"}, "customerNeedsLimit": {"default": 10, "description": "Customer needs per page when includeCustomerNeeds is true (default 10, max 50)", "maximum": 50, "minimum": 1, "type": "integer"}, "includeCustomerNeeds": {"default": false, "description": "Include one page of customer needs attached directly to the project", "type": "boolean"}, "includeMembers": {"default": false, "description": "Include project members", "type": "boolean"}, "includeMilestones": {"default": false, "description": "Include milestones", "type": "boolean"}, "includeResources": {"default": false, "description": "Include resources (documents, links, attachments)", "type": "boolean"}, "query": {"description": "Project name, ID, identifier (e.g., P-ENG-123), or slug", "type": "string"}}, "required": ["query"], "type": "object"}, "name": "get_project"}, {"description": "List available project labels in a Linear workspace or team. Returns workspace labels by default; pass `team` to also include that team's labels. A team-scoped label carries a `team` field; different teams can hold same-named labels, so check it before acting on an ID. A retired label carries `retiredAt` and cannot be applied to new projects.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"cursor": {"description": "Next page cursor", "type": "string"}, "includeArchived": {"default": false, "description": "Include archived items", "type": "boolean"}, "includeGroups": {"default": false, "description": "Include label groups in the results, marked with `isGroup`. A group cannot be applied directly; retiring or restoring one cascades to its child labels", "type": "boolean"}, "limit": {"default": 50, "description": "Max results (default 50, max 250)", "maximum": 250, "type": "number"}, "name": {"description": "Filter by name", "type": "string"}, "orderBy": {"default": "updatedAt", "description": "Sort: createdAt | updatedAt", "enum": ["createdAt", "updatedAt"], "type": "string"}, "team": {"description": "Team name or ID", "type": "string"}}, "type": "object"}, "name": "list_project_labels"}, {"description": "Retire a Linear project label so it cannot be applied to new projects. The label stays visible on projects that already have it. Retiring a label group also retires its child labels. Undo with `restore_project_label`.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"id": {"description": "Label or label group ID", "type": "string"}}, "required": ["id"], "type": "object"}, "name": "retire_project_label"}, {"description": "Restore a retired Linear project label, making it available for use on projects again. Restoring a label group also restores every child label, including any that were retired separately.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"id": {"description": "Label or label group ID", "type": "string"}}, "required": ["id"], "type": "object"}, "name": "restore_project_label"}, {"description": "Create or update a Linear project label. If `id` is provided, updates the existing label; otherwise creates a new one. When creating, `name` is required.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"color": {"description": "Hex color code", "type": "string"}, "description": {"description": "Label description. Null to clear it", "type": ["string", "null"]}, "id": {"description": "Label name or ID. If provided, updates the existing label", "type": "string"}, "isGroup": {"description": "Whether the label is a group", "type": "boolean"}, "name": {"description": "Label name (required when creating)", "type": "string"}, "parent": {"description": "Parent label group name or ID. Null to remove from its group", "type": ["string", "null"]}, "teamId": {"description": "Team UUID (omit for workspace label). When updating, only disambiguates `id` by name; a label's team cannot be changed", "type": "string"}}, "type": "object"}, "name": "save_project_label"}, {"description": "List release pipelines in the workspace.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"createdAt": {"description": "Created after: ISO-8601 date/duration (e.g., -P1D)", "type": "string"}, "cursor": {"description": "Next page cursor", "type": "string"}, "includeArchived": {"default": false, "description": "Include archived items", "type": "boolean"}, "includeStages": {"default": false, "description": "Include each pipeline's stages", "type": "boolean"}, "includeTeams": {"default": false, "description": "Include each pipeline's teams", "type": "boolean"}, "isProduction": {"description": "Filter by production pipeline flag", "type": "boolean"}, "limit": {"default": 50, "description": "Max results (default 50, max 250)", "maximum": 250, "type": "number"}, "orderBy": {"default": "updatedAt", "description": "Sort: createdAt | updatedAt", "enum": ["createdAt", "updatedAt"], "type": "string"}, "query": {"description": "Search pipeline name", "type": "string"}, "team": {"description": "Team name or ID", "type": "string"}, "type": {"description": "Pipeline type: continuous | scheduled", "enum": ["continuous", "scheduled"], "type": "string"}, "updatedAt": {"description": "Updated after: ISO-8601 date/duration (e.g., -P1D)", "type": "string"}}, "type": "object"}, "name": "list_release_pipelines"}, {"description": "List releases in the workspace, with optional filtering by pipeline, stage, version, and text.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"createdAt": {"description": "Created after: ISO-8601 date/duration (e.g., -P1D)", "type": "string"}, "cursor": {"description": "Next page cursor", "type": "string"}, "hasReleaseNotes": {"description": "Filter to releases that do (true) or do not (false) have release notes", "type": "boolean"}, "includeArchived": {"default": false, "description": "Include archived items", "type": "boolean"}, "includeReleaseNotes": {"default": false, "description": "Include associated release notes", "type": "boolean"}, "limit": {"default": 50, "description": "Max results (default 50, max 250)", "maximum": 250, "type": "number"}, "orderBy": {"default": "updatedAt", "description": "Sort: createdAt | updatedAt", "enum": ["createdAt", "updatedAt"], "type": "string"}, "pipeline": {"description": "Release pipeline ID, slug, or exact name", "type": "string"}, "query": {"description": "Search release name or version", "type": "string"}, "stage": {"description": "Release stage ID or exact name", "type": "string"}, "stageType": {"description": "Filter by stage lifecycle type", "enum": ["planned", "started", "completed", "canceled"], "type": "string"}, "updatedAt": {"description": "Updated after: ISO-8601 date/duration (e.g., -P1D)", "type": "string"}, "version": {"description": "Exact version match", "type": "string"}}, "type": "object"}, "name": "list_releases"}, {"description": "Retrieve details of a release by ID or slug.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"id": {"description": "Release ID or slug", "type": "string"}, "includeReleaseNotes": {"default": false, "description": "Include associated release notes", "type": "boolean"}}, "required": ["id"], "type": "object"}, "name": "get_release"}, {"description": "Create or update a release. If `id` is provided, updates the existing release; otherwise creates a new one. When creating, `name` and `pipeline` are required. Release status is modeled as the release pipeline stage.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"commitSha": {"description": "Commit SHA associated with the release", "type": "string"}, "completedAt": {"description": "Completed timestamp (ISO DateTime, null to remove)", "type": ["string", "null"]}, "createdAt": {"description": "Import/create timestamp (ISO DateTime)", "type": "string"}, "description": {"description": "Release description", "type": "string"}, "id": {"description": "Release ID or slug to update. Omit to create a new release.", "type": "string"}, "name": {"description": "Release name (required when creating)", "type": "string"}, "pipeline": {"description": "Release pipeline ID, slug, or exact name (required when creating)", "type": "string"}, "stage": {"description": "Release stage ID, exact name, or lifecycle type within the release pipeline", "type": "string"}, "startDate": {"description": "Estimated start date (ISO YYYY-MM-DD, null to remove)", "type": ["string", "null"]}, "startedAt": {"description": "Started timestamp (ISO DateTime, null to remove)", "type": ["string", "null"]}, "targetDate": {"description": "Estimated completion date (ISO YYYY-MM-DD, null to remove)", "type": ["string", "null"]}, "version": {"description": "Version identifier", "type": "string"}}, "type": "object"}, "name": "save_release"}, {"description": "List release notes in the workspace, optionally filtered by pipeline or covered release.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"createdAt": {"description": "Created after: ISO-8601 date/duration (e.g., -P1D)", "type": "string"}, "cursor": {"description": "Next page cursor", "type": "string"}, "includeArchived": {"default": false, "description": "Include archived items", "type": "boolean"}, "includeContent": {"default": false, "description": "Include markdown release notes content", "type": "boolean"}, "includeReleases": {"default": false, "description": "Include associated releases", "type": "boolean"}, "limit": {"default": 50, "description": "Max results (default 50, max 250)", "maximum": 250, "type": "number"}, "orderBy": {"default": "updatedAt", "description": "Sort: createdAt | updatedAt", "enum": ["createdAt", "updatedAt"], "type": "string"}, "pipeline": {"description": "Release pipeline ID, slug, or exact name", "type": "string"}, "query": {"description": "Search release notes title", "type": "string"}, "release": {"description": "Release ID or slug", "type": "string"}, "updatedAt": {"description": "Updated after: ISO-8601 date/duration (e.g., -P1D)", "type": "string"}}, "type": "object"}, "name": "list_release_notes"}, {"description": "Retrieve release notes by ID or slug, including markdown content.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"id": {"description": "Release notes ID or slug", "type": "string"}, "includeReleases": {"default": false, "description": "Include associated releases", "type": "boolean"}}, "required": ["id"], "type": "object"}, "name": "get_release_note"}, {"description": "Share an issue with a workspace user who cannot otherwise access it. Use this tool only when the user explicitly asks to share the issue.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"issue": {"description": "Issue ID or identifier (e.g., LIN-123). P-prefixed identifiers (e.g., P-ENG-123) are projects, not issues", "type": "string"}, "user": {"description": "User ID, name, email, or \"me\" Must be an email address or UUID.", "type": "string"}}, "required": ["issue", "user"], "type": "object"}, "name": "share_issue"}, {"description": "Remove a workspace user's shared access to an issue. Use this tool only when the user explicitly asks to stop sharing the issue.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"issue": {"description": "Issue ID or identifier (e.g., LIN-123). P-prefixed identifiers (e.g., P-ENG-123) are projects, not issues", "type": "string"}, "user": {"description": "User ID, name, email, or \"me\" Must be an email address or UUID.", "type": "string"}}, "required": ["issue", "user"], "type": "object"}, "name": "unshare_issue"}, {"description": "List all milestones in a Linear project", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"project": {"description": "Project name, ID, identifier (e.g., P-ENG-123), or slug", "type": "string"}}, "required": ["project"], "type": "object"}, "name": "list_milestones"}, {"description": "Retrieve details of a specific milestone by ID or name", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"project": {"description": "Project name, ID, identifier (e.g., P-ENG-123), or slug", "type": "string"}, "query": {"description": "Milestone name or ID", "type": "string"}}, "required": ["project", "query"], "type": "object"}, "name": "get_milestone"}, {"description": "Create or update a milestone in a Linear project. If `id` is provided, updates the existing milestone; otherwise creates a new one. When creating, `name` is required.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"description": {"description": "Milestone description", "type": "string"}, "id": {"description": "Milestone name or ID", "type": "string"}, "name": {"description": "Milestone name (required when creating)", "type": "string"}, "project": {"description": "Project name, ID, identifier (e.g., P-ENG-123), or slug", "type": "string"}, "targetDate": {"description": "Target completion date (ISO format, null to remove)", "type": ["string", "null"]}}, "required": ["project"], "type": "object"}, "name": "save_milestone"}, {"description": "Get a page of notifications from the authenticated user's Linear inbox.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"cursor": {"description": "Next page cursor", "type": "string"}, "limit": {"default": 50, "description": "Max results (default 50, max 250)", "maximum": 250, "type": "number"}, "unreadOnly": {"default": false, "description": "Only return unread notifications", "type": "boolean"}}, "type": "object"}, "name": "get_notifications"}, {"description": "Mark a Linear inbox notification as read or unread, or snooze or unsnooze it.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"id": {"description": "Notification ID", "type": "string"}, "read": {"description": "Whether the notification should be marked as read", "type": "boolean"}, "snoozedUntilAt": {"anyOf": [{"format": "date-time", "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$", "type": "string"}, {"type": "null"}], "description": "ISO-8601 time to snooze until, or null to unsnooze"}}, "required": ["id"], "type": "object"}, "name": "mark_notification"}, {"description": "List teams in the user's Linear workspace", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"createdAt": {"description": "Created after: ISO-8601 date/duration (e.g., -P1D)", "type": "string"}, "cursor": {"description": "Next page cursor", "type": "string"}, "includeArchived": {"default": false, "description": "Include archived items", "type": "boolean"}, "limit": {"default": 50, "description": "Max results (default 50, max 250)", "maximum": 250, "type": "number"}, "orderBy": {"default": "updatedAt", "description": "Sort: createdAt | updatedAt", "enum": ["createdAt", "updatedAt"], "type": "string"}, "query": {"description": "Search query", "type": "string"}, "updatedAt": {"description": "Updated after: ISO-8601 date/duration (e.g., -P1D)", "type": "string"}}, "type": "object"}, "name": "list_teams"}, {"description": "Retrieve details of a specific Linear team", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"query": {"description": "Team UUID, key, or name", "type": "string"}}, "required": ["query"], "type": "object"}, "name": "get_team"}, {"description": "Retrieve who is responsible for a team's triage: the person on triage now, what happens when an issue enters triage, and the upcoming shifts of the team's triage rotation. Pass `user` to get only that person's shifts, for example to find when their next triage duty starts, even when it is weeks away.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"limit": {"default": 10, "description": "Max upcoming shifts to return (default 10, max 50)", "maximum": 50, "minimum": 1, "type": "integer"}, "team": {"description": "Team name or ID", "type": "string"}, "user": {"description": "Only return shifts of this user: User ID, name, email, or \"me\"", "type": "string"}}, "required": ["team"], "type": "object"}, "name": "get_triage_responsibility"}, {"description": "List the Linear issue, project, and document templates available to the authenticated user. Use this to find the template a team expects, then call get_template for its content.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"team": {"description": "Team name or ID. Returns that team's templates plus workspace-level ones", "type": "string"}, "type": {"description": "Filter by template type. Omit to return every type", "enum": ["issue", "project", "document"], "type": "string"}}, "type": "object"}, "name": "list_templates"}, {"description": "Retrieve a Linear template by ID or name: the content it pre-fills, the ids it applies, its sub-issues, and its form fields. Pass the template to save_issue or save_project to apply it. References come back as ids, so read a name with the matching tool when you need one. A form template collects its answers through a form, so applying one here creates an issue with the form unanswered.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"id": {"description": "Template ID or name", "type": "string"}}, "required": ["id"], "type": "object"}, "name": "get_template"}, {"description": "Retrieve users in the Linear workspace", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"cursor": {"description": "Next page cursor", "type": "string"}, "limit": {"default": 50, "description": "Max results (default 50, max 250)", "maximum": 250, "type": "number"}, "orderBy": {"default": "updatedAt", "description": "Sort: createdAt | updatedAt", "enum": ["createdAt", "updatedAt"], "type": "string"}, "query": {"description": "Filter by name or email", "type": "string"}, "team": {"description": "Team name or ID", "type": "string"}}, "type": "object"}, "name": "list_users"}, {"description": "Retrieve details of a specific Linear user", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"query": {"description": "User ID, name, email, or \"me\"", "type": "string"}}, "required": ["query"], "type": "object"}, "name": "get_user"}, {"description": "Retrieve the connected Linear workspace", "input_schema": {"properties": {}, "type": "object"}, "name": "get_workspace"}, {"description": "Search Linear's documentation to learn about features and usage", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"page": {"default": 0, "description": "Page number", "type": "number"}, "query": {"description": "Search query", "type": "string"}}, "required": ["query"], "type": "object"}, "name": "search_documentation"}, {"description": "Exact lookup for a Linear diff. Use with review URLs, GitHub PR URLs, Linear full identifiers, UUIDs, or slugs.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"urlOrId": {"description": "Linear review URL, diff slug, pull request ID, Linear full identifier, or GitHub PR URL", "minLength": 1, "type": "string"}}, "required": ["urlOrId"], "type": "object"}, "name": "get_diff"}, {"description": "List Linear diff pull requests visible to the authenticated user", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"author": {"description": "Filter by author ID, name, email, or \"me\"", "type": "string"}, "cursor": {"description": "Next page cursor", "type": "string"}, "limit": {"default": 50, "description": "Max results (default 50, max 250)", "maximum": 250, "type": "number"}, "orderBy": {"default": "updatedAt", "description": "Sort: createdAt | updatedAt", "enum": ["createdAt", "updatedAt"], "type": "string"}, "owner": {"description": "Filter returned diffs by repository owner", "type": "string"}, "query": {"description": "Broad search by title, branch, PR number, or bare slug", "type": "string"}, "repo": {"description": "Filter returned diffs by repository name", "type": "string"}, "reviewState": {"description": "Reviewer state; requires reviewer and defaults to pending when reviewer is set", "enum": ["pending", "approved", "changesRequested", "commented", "dismissed"], "type": "string"}, "reviewer": {"description": "Filter by reviewer ID, name, email, or \"me\"", "type": "string"}, "status": {"description": "Filter returned diffs by pull request status", "type": "string"}}, "type": "object"}, "name": "list_diffs"}, {"description": "Exact lookup for diff threads and the authenticated user's drafts. Use with review URLs, GitHub PR URLs, Linear full identifiers, UUIDs, or slugs.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"orderBy": {"default": "updatedAt", "description": "Sort: createdAt | updatedAt", "enum": ["createdAt", "updatedAt"], "type": "string"}, "resolved": {"description": "Filter returned threads by resolved state", "type": "boolean"}, "threadId": {"description": "Optional Linear comment UUID of any comment in the thread (not its `externalThreadId`); a reply's UUID resolves to its thread root", "type": "string"}, "urlOrId": {"description": "Linear review URL, diff slug, pull request ID, Linear full identifier, or GitHub PR URL", "minLength": 1, "type": "string"}}, "required": ["urlOrId"], "type": "object"}, "name": "get_diff_threads"}, {"description": "Resolve or reopen a top-level comment thread on a Linear diff", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"resolved": {"default": true, "description": "True to resolve the thread; false to reopen it", "type": "boolean"}, "threadId": {"description": "Top-level diff thread/comment ID", "minLength": 1, "type": "string"}}, "required": ["threadId"], "type": "object"}, "name": "resolve_diff_thread"}, {"description": "Delete a comment or persisted draft from a Linear diff", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"commentId": {"description": "Submitted diff comment ID to delete", "minLength": 1, "type": "string"}, "draftId": {"description": "Persisted diff comment draft ID to delete", "minLength": 1, "type": "string"}}, "type": "object"}, "name": "delete_diff_comment"}, {"description": "Approve a Linear diff, request changes, or submit a review comment", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"body": {"description": "Content as Markdown. Do not escape the string \u2014 use literal newlines and special characters, not escape sequences. Required when requesting changes or commenting", "minLength": 1, "type": "string"}, "decision": {"description": "Review decision: approved, changesRequested, or commented", "enum": ["approved", "changesRequested", "commented"], "type": "string"}, "urlOrId": {"description": "Linear review URL, diff slug, pull request ID, Linear full identifier, or GitHub PR URL", "minLength": 1, "type": "string"}}, "required": ["urlOrId", "decision"], "type": "object"}, "name": "submit_diff_review"}, {"description": "Update a Linear diff's title, description, reviewer requests, issue links, or status. Provide at least one update. Combined updates can partially succeed; inspect the result before retrying. Use merge_diff to merge and submit_diff_review to approve or request changes.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"addedIssueLinks": {"description": "Add issue links or change the relationship of an existing link", "items": {"additionalProperties": false, "properties": {"issue": {"description": "Linear issue identifier or UUID", "minLength": 1, "type": "string"}, "type": {"description": "Relationship: closes, contributes, links, or reopens", "enum": ["closes", "contributes", "links", "reopens"], "type": "string"}}, "required": ["issue", "type"], "type": "object"}, "maxItems": 25, "minItems": 1, "type": "array"}, "addedReviewRequests": {"description": "Request or re-request reviews; existing pending requests are unchanged", "items": {"anyOf": [{"additionalProperties": false, "properties": {"user": {"description": "Workspace user ID, name, email, or \"me\"", "minLength": 1, "type": "string"}}, "required": ["user"], "type": "object"}, {"additionalProperties": false, "properties": {"externalUserId": {"description": "External user ID from get_diff reviewer metadata", "format": "uuid", "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$", "type": "string"}}, "required": ["externalUserId"], "type": "object"}, {"additionalProperties": false, "properties": {"githubTeamId": {"description": "GitHub team ID from get_diff reviewer metadata", "format": "uuid", "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$", "type": "string"}}, "required": ["githubTeamId"], "type": "object"}]}, "maxItems": 25, "minItems": 1, "type": "array"}, "description": {"description": "New description as Markdown; an empty string clears it", "type": "string"}, "removedIssueLinks": {"description": "Linear issue identifiers or UUIDs to unlink", "items": {"minLength": 1, "type": "string"}, "maxItems": 25, "minItems": 1, "type": "array"}, "removedReviewRequests": {"description": "Withdraw pending review requests; submitted reviews are preserved", "items": {"anyOf": [{"additionalProperties": false, "properties": {"user": {"description": "Workspace user ID, name, email, or \"me\"", "minLength": 1, "type": "string"}}, "required": ["user"], "type": "object"}, {"additionalProperties": false, "properties": {"externalUserId": {"description": "External user ID from get_diff reviewer metadata", "format": "uuid", "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$", "type": "string"}}, "required": ["externalUserId"], "type": "object"}, {"additionalProperties": false, "properties": {"githubTeamId": {"description": "GitHub team ID from get_diff reviewer metadata", "format": "uuid", "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$", "type": "string"}}, "required": ["githubTeamId"], "type": "object"}]}, "maxItems": 25, "minItems": 1, "type": "array"}, "statusAction": {"description": "Status transition to perform after metadata is updated", "enum": ["markReadyForReview", "convertToDraft", "close", "reopen"], "type": "string"}, "title": {"description": "New diff title", "minLength": 1, "type": "string"}, "urlOrId": {"description": "Linear review URL, diff slug, pull request ID, Linear full identifier, or GitHub PR URL", "minLength": 1, "type": "string"}}, "required": ["urlOrId"], "type": "object"}, "name": "update_diff"}, {"description": "Merge a Linear diff or add it to the repository's merge queue", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"mergeMethod": {"description": "Merge method; omit to use the repository default", "enum": ["MERGE", "REBASE", "SQUASH"], "type": "string"}, "urlOrId": {"description": "Linear review URL, diff slug, pull request ID, Linear full identifier, or GitHub PR URL", "minLength": 1, "type": "string"}}, "required": ["urlOrId"], "type": "object"}, "name": "merge_diff"}, {"description": "List or get project/initiative status updates. Pass `id` to get a specific update, or filter to list.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"createdAt": {"description": "Created after: ISO-8601 date/duration (e.g., -P1D)", "type": "string"}, "cursor": {"description": "Next page cursor", "type": "string"}, "id": {"description": "Status update ID - if provided, returns this specific update", "type": "string"}, "includeArchived": {"default": false, "description": "Include archived items", "type": "boolean"}, "initiative": {"description": "Initiative name, ID, identifier (e.g., I-123), or slug", "type": "string"}, "limit": {"default": 50, "description": "Max results (default 50, max 250)", "maximum": 250, "type": "number"}, "orderBy": {"default": "updatedAt", "description": "Sort: createdAt | updatedAt", "enum": ["createdAt", "updatedAt"], "type": "string"}, "project": {"description": "Project name, ID, identifier (e.g., P-ENG-123), or slug", "type": "string"}, "type": {"description": "Type of status update", "enum": ["project", "initiative"], "type": "string"}, "updatedAt": {"description": "Updated after: ISO-8601 date/duration (e.g., -P1D)", "type": "string"}, "user": {"description": "User ID, name, email, or \"me\"", "type": "string"}}, "required": ["type"], "type": "object"}, "name": "get_status_updates"}, {"description": "Create or update a project/initiative status update. Omit `id` to create, provide `id` to update.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"body": {"description": "Content as Markdown. Do not escape the string \u2014 use literal newlines and special characters, not escape sequences. To mention a user, use @displayName (e.g., @johndoe)", "type": "string"}, "health": {"description": "onTrack | atRisk | offTrack", "enum": ["onTrack", "atRisk", "offTrack"], "type": "string"}, "id": {"description": "Status update ID - if provided, updates this existing update", "type": "string"}, "initiative": {"description": "Initiative name, ID, identifier (e.g., I-123), or slug", "type": "string"}, "isDiffHidden": {"description": "Deprecated. Hide diff with previous update (create only)", "type": "boolean"}, "project": {"description": "Project name, ID, identifier (e.g., P-ENG-123), or slug", "type": "string"}, "type": {"description": "Type of status update", "enum": ["project", "initiative"], "type": "string"}}, "required": ["type"], "type": "object"}, "name": "save_status_update"}, {"description": "Delete (archive) a project or initiative status update.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"id": {"description": "Status update ID", "type": "string"}, "type": {"description": "Type of status update", "enum": ["project", "initiative"], "type": "string"}}, "required": ["type", "id"], "type": "object"}, "name": "delete_status_update"}], "type": "mcp_list_tools"}, "output_index": 2, "sequence_number": 8, "type": "response.output_item.done"}, "topic": "events"}

