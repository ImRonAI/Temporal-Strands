Include archived items", "type": "boolean"}, "includeStages": {"default": false, "description": "Include each pipeline's stages", "type": "boolean"}, "includeTeams": {"default": false, "description": "Include each pipeline's teams", "type": "boolean"}, "isProduction": {"description": "Filter by production pipeline flag", "type": "boolean"}, "limit": {"default": 50, "description": "Max results (default 50, max 250)", "maximum": 250, "type": "number"}, "orderBy": {"default": "updatedAt", "description": "Sort: createdAt | updatedAt", "enum": ["createdAt", "updatedAt"], "type": "string"}, "query": {"description": "Search pipeline name", "type": "string"}, "team": {"description": "Team name or ID", "type": "string"}, "type": {"description": "Pipeline type: continuous | scheduled", "enum": ["continuous", "scheduled"], "type": "string"}, "updatedAt": {"description": "Updated after: ISO-8601 date/duration (e.g., -P1D)", "type": "string"}}, "type": "object"}, "name": "list_release_pipelines"}, {"description": "List releases in the workspace, with optional filtering by pipeline, stage, version, and text.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"createdAt": {"description": "Created after: ISO-8601 date/duration (e.g., -P1D)", "type": "string"}, "cursor": {"description": "Next page cursor", "type": "string"}, "hasReleaseNotes": {"description": "Filter to releases that do (true) or do not (false) have release notes", "type": "boolean"}, "includeArchived": {"default": false, "description": "Include archived items", "type": "boolean"}, "includeReleaseNotes": {"default": false, "description": "Include associated release notes", "type": "boolean"}, "limit": {"default": 50, "description": "Max results (default 50, max 250)", "maximum": 250, "type": "number"}, "orderBy": {"default": "updatedAt", "description": "Sort: createdAt | updatedAt", "enum": ["createdAt", "updatedAt"], "type": "string"}, "pipeline": {"description": "Release pipeline ID, slug, or exact name", "type": "string"}, "query": {"description": "Search release name or version", "type": "string"}, "stage": {"description": "Release stage ID or exact name", "type": "string"}, "stageType": {"description": "Filter by stage lifecycle type", "enum": ["planned", "started", "completed", "canceled"], "type": "string"}, "updatedAt": {"description": "Updated after: ISO-8601 date/duration (e.g., -P1D)", "type": "string"}, "version": {"description": "Exact version match", "type": "string"}}, "type": "object"}, "name": "list_releases"}, {"description": "Retrieve details of a release by ID or slug.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"id": {"description": "Release ID or slug", "type": "string"}, "includeReleaseNotes": {"default": false, "description": "Include associated release notes", "type": "boolean"}}, "required": ["id"], "type": "object"}, "name": "get_release"}, {"description": "Create or update a release. If `id` is provided, updates the existing release; otherwise creates a new one. When creating, `name` and `pipeline` are required. Release status is modeled as the release pipeline stage.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"commitSha": {"description": "Commit SHA associated with the release", "type": "string"}, "completedAt": {"description": "Completed timestamp (ISO DateTime, null to remove)", "type": ["string", "null"]}, "createdAt": {"description": "Import/create timestamp (ISO DateTime)", "type": "string"}, "description": {"description": "Release description", "type": "string"}, "id": {"description": "Release ID or slug to update. Omit to create a new release.", "type": "string"}, "name": {"description": "Release name (required when creating)", "type": "string"}, "pipeline": {"description": "Release pipeline ID, slug, or exact name (required when creating)", "type": "string"}, "stage": {"description": "Release stage ID, exact name, or lifecycle type within the release pipeline", "type": "string"}, "startDate": {"description": "Estimated start date (ISO YYYY-MM-DD, null to remove)", "type": ["string", "null"]}, "startedAt": {"description": "Started timestamp (ISO DateTime, null to remove)", "type": ["string", "null"]}, "targetDate": {"description": "Estimated completion date (ISO YYYY-MM-DD, null to remove)", "type": ["string", "null"]}, "version": {"description": "Version identifier", "type": "string"}}, "type": "object"}, "name": "save_release"}, {"description": "List release notes in the workspace, optionally filtered by pipeline or covered release.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"createdAt": {"description": "Created after: ISO-8601 date/duration (e.g., -P1D)", "type": "string"}, "cursor": {"description": "Next page cursor", "type": "string"}, "includeArchived": {"default": false, "description": "Include archived items", "type": "boolean"}, "includeContent": {"default": false, "description": "Include markdown release notes content", "type": "boolean"}, "includeReleases": {"default": false, "description": "Include associated releases", "type": "boolean"}, "limit": {"default": 50, "description": "Max results (default 50, max 250)", "maximum": 250, "type": "number"}, "orderBy": {"default": "updatedAt", "description": "Sort: createdAt | updatedAt", "enum": ["createdAt", "updatedAt"], "type": "string"}, "pipeline": {"description": "Release pipeline ID, slug, or exact name", "type": "string"}, "query": {"description": "Search release notes title", "type": "string"}, "release": {"description": "Release ID or slug", "type": "string"}, "updatedAt": {"description": "Updated after: ISO-8601 date/duration (e.g., -P1D)", "type": "string"}}, "type": "object"}, "name": "list_release_notes"}, {"description": "Retrieve release notes by ID or slug, including markdown content.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"id": {"description": "Release notes ID or slug", "type": "string"}, "includeReleases": {"default": false, "description": "Include associated releases", "type": "boolean"}}, "required": ["id"], "type": "object"}, "name": "get_release_note"}, {"description": "Share an issue with a workspace user who cannot otherwise access it. Use this tool only when the user explicitly asks to share the issue.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"issue": {"description": "Issue ID or identifier (e.g., LIN-123). P-prefixed identifiers (e.g., P-ENG-123) are projects, not issues", "type": "string"}, "user": {"description": "User ID, name, email, or \"me\" Must be an email address or UUID.", "type": "string"}}, "required": ["issue", "user"], "type": "object"}, "name": "share_issue"}, {"description": "Remove a workspace user's shared access to an issue. Use this tool only when the user explicitly asks to stop sharing the issue.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"issue": {"description": "Issue ID or identifier (e.g., LIN-123). P-prefixed identifiers (e.g., P-ENG-123) are projects, not issues", "type": "string"}, "user": {"description": "User ID, name, email, or \"me\" Must be an email address or UUID.", "type": "string"}}, "required": ["issue", "user"], "type": "object"}, "name": "unshare_issue"}, {"description": "List all milestones in a Linear project", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"project": {"description": "Project name, ID, identifier (e.g., P-ENG-123), or slug", "type": "string"}}, "required": ["project"], "type": "object"}, "name": "list_milestones"}, {"description": "Retrieve details of a specific milestone by ID or name", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"project": {"description": "Project name, ID, identifier (e.g., P-ENG-123), or slug", "type": "string"}, "query": {"description": "Milestone name or ID", "type": "string"}}, "required": ["project", "query"], "type": "object"}, "name": "get_milestone"}, {"description": "Create or update a milestone in a Linear project. If `id` is provided, updates the existing milestone; otherwise creates a new one. When creating, `name` is required.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"description": {"description": "Milestone description", "type": "string"}, "id": {"description": "Milestone name or ID", "type": "string"}, "name": {"description": "Milestone name (required when creating)", "type": "string"}, "project": {"description": "Project name, ID, identifier (e.g., P-ENG-123), or slug", "type": "string"}, "targetDate": {"description": "Target completion date (ISO format, null to remove)", "type": ["string", "null"]}}, "required": ["project"], "type": "object"}, "name": "save_milestone"}, {"description": "Get a page of notifications from the authenticated user's Linear inbox.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"cursor": {"description": "Next page cursor", "type": "string"}, "limit": {"default": 50, "description": "Max results (default 50, max 250)", "maximum": 250, "type": "number"}, "unreadOnly": {"default": false, "description": "Only return unread notifications", "type": "boolean"}}, "type": "object"}, "name": "get_notifications"}, {"description": "Mark a Linear inbox notification as read or unread, or snooze or unsnooze it.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"id": {"description": "Notification ID", "type": "string"}, "read": {"description": "Whether the notification should be marked as read", "type": "boolean"}, "snoozedUntilAt": {"anyOf": [{"format": "date-time", "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$", "type": "string"}, {"type": "null"}], "description": "ISO-8601 time to snooze until, or null to unsnooze"}}, "required": ["id"], "type": "object"}, "name": "mark_notification"}, {"description": "List teams in the user's Linear workspace", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"createdAt": {"description": "Created after: ISO-8601 date/duration (e.g., -P1D)", "type": "string"}, "cursor": {"description": "Next page cursor", "type": "string"}, "includeArchived": {"default": false, "description": "Include archived items", "type": "boolean"}, "limit": {"default": 50, "description": "Max results (default 50, max 250)", "maximum": 250, "type": "number"}, "orderBy": {"default": "updatedAt", "description": "Sort: createdAt | updatedAt", "enum": ["createdAt", "updatedAt"], "type": "string"}, "query": {"description": "Search query", "type": "string"}, "updatedAt": {"description": "Updated after: ISO-8601 date/duration (e.g., -P1D)", "type": "string"}}, "type": "object"}, "name": "list_teams"}, {"description": "Retrieve details of a specific Linear team", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"query": {"description": "Team UUID, key, or name", "type": "string"}}, "required": ["query"], "type": "object"}, "name": "get_team"}, {"description": "Retrieve who is responsible for a team's triage: the person on triage now, what happens when an issue enters triage, and the upcoming shifts of the team's triage rotation. Pass `user` to get only that person's shifts, for example to find when their next triage duty starts, even when it is weeks away.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"limit": {"default": 10, "description": "Max upcoming shifts to return (default 10, max 50)", "maximum": 50, "minimum": 1, "type": "integer"}, "team": {"description": "Team name or ID", "type": "string"}, "user": {"description": "Only return shifts of this user: User ID, name, email, or \"me\"", "type": "string"}}, "required": ["team"], "type": "object"}, "name": "get_triage_responsibility"}, {"description": "List the Linear issue, project, and document templates available to the authenticated user. Use this to find the template a team expects, then call get_template for its content.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"team": {"description": "Team name or ID. Returns that team's templates plus workspace-level ones", "type": "string"}, "type": {"description": "Filter by template type. Omit to return every type", "enum": ["issue", "project", "document"], "type": "string"}}, "type": "object"}, "name": "list_templates"}, {"description": "Retrieve a Linear template by ID or name: the content it pre-fills, the ids it applies, its sub-issues, and its form fields. Pass the template to save_issue or save_project to apply it. References come back as ids, so read a name with the matching tool when you need one. A form template collects its answers through a form, so applying one here creates an issue with the form unanswered.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"id": {"description": "Template ID or name", "type": "string"}}, "required": ["id"], "type": "object"}, "name": "get_template"}, {"description": "Retrieve users in the Linear workspace", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"cursor": {"description": "Next page cursor", "type": "string"}, "limit": {"default": 50, "description": "Max results (default 50, max 250)", "maximum": 250, "type": "number"}, "orderBy": {"default": "updatedAt", "description": "Sort: createdAt | updatedAt", "enum": ["createdAt", "updatedAt"], "type": "string"}, "query": {"description": "Filter by name or email", "type": "string"}, "team": {"description": "Team name or ID", "type": "string"}}, "type": "object"}, "name": "list_users"}, {"description": "Retrieve details of a specific Linear user", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"query": {"description": "User ID, name, email, or \"me\"", "type": "string"}}, "required": ["query"], "type": "object"}, "name": "get_user"}, {"description": "Retrieve the connected Linear workspace", "input_schema": {"properties": {}, "type": "object"}, "name": "get_workspace"}, {"description": "Search Linear's documentation to learn about features and usage", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"page": {"default": 0, "description": "Page number", "type": "number"}, "query": {"description": "Search query", "type": "string"}}, "required": ["query"], "type": "object"}, "name": "search_documentation"}, {"description": "Exact lookup for a Linear diff. Use with review URLs, GitHub PR URLs, Linear full identifiers, UUIDs, or slugs.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"urlOrId": {"description": "Linear review URL, diff slug, pull request ID, Linear full identifier, or GitHub PR URL", "minLength": 1, "type": "string"}}, "required": ["urlOrId"], "type": "object"}, "name": "get_diff"}, {"description": "List Linear diff pull requests visible to the authenticated user", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"author": {"description": "Filter by author ID, name, email, or \"me\"", "type": "string"}, "cursor": {"description": "Next page cursor", "type": "string"}, "limit": {"default": 50, "description": "Max results (default 50, max 250)", "maximum": 250, "type": "number"}, "orderBy": {"default": "updatedAt", "description": "Sort: createdAt | updatedAt", "enum": ["createdAt", "updatedAt"], "type": "string"}, "owner": {"description": "Filter returned diffs by repository owner", "type": "string"}, "query": {"description": "Broad search by title, branch, PR number, or bare slug", "type": "string"}, "repo": {"description": "Filter returned diffs by repository name", "type": "string"}, "reviewState": {"description": "Reviewer state; requires reviewer and defaults to pending when reviewer is set", "enum": ["pending", "approved", "changesRequested", "commented", "dismissed"], "type": "string"}, "reviewer": {"description": "Filter by reviewer ID, name, email, or \"me\"", "type": "string"}, "status": {"description": "Filter returned diffs by pull request status", "type": "string"}}, "type": "object"}, "name": "list_diffs"}, {"description": "Exact lookup for diff threads and the authenticated user's drafts. Use with review URLs, GitHub PR URLs, Linear full identifiers, UUIDs, or slugs.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"orderBy": {"default": "updatedAt", "description": "Sort: createdAt | updatedAt", "enum": ["createdAt", "updatedAt"], "type": "string"}, "resolved": {"description": "Filter returned threads by resolved state", "type": "boolean"}, "threadId": {"description": "Optional Linear comment UUID of any comment in the thread (not its `externalThreadId`); a reply's UUID resolves to its thread root", "type": "string"}, "urlOrId": {"description": "Linear review URL, diff slug, pull request ID, Linear full identifier, or GitHub PR URL", "minLength": 1, "type": "string"}}, "required": ["urlOrId"], "type": "object"}, "name": "get_diff_threads"}, {"description": "Resolve or reopen a top-level comment thread on a Linear diff", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"resolved": {"default": true, "description": "True to resolve the thread; false to reopen it", "type": "boolean"}, "threadId": {"description": "Top-level diff thread/comment ID", "minLength": 1, "type": "string"}}, "required": ["threadId"], "type": "object"}, "name": "resolve_diff_thread"}, {"description": "Delete a comment or persisted draft from a Linear diff", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"commentId": {"description": "Submitted diff comment ID to delete", "minLength": 1, "type": "string"}, "draftId": {"description": "Persisted diff comment draft ID to delete", "minLength": 1, "type": "string"}}, "type": "object"}, "name": "delete_diff_comment"}, {"description": "Approve a Linear diff, request changes, or submit a review comment", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"body": {"description": "Content as Markdown. Do not escape the string \u2014 use literal newlines and special characters, not escape sequences. Required when requesting changes or commenting", "minLength": 1, "type": "string"}, "decision": {"description": "Review decision: approved, changesRequested, or commented", "enum": ["approved", "changesRequested", "commented"], "type": "string"}, "urlOrId": {"description": "Linear review URL, diff slug, pull request ID, Linear full identifier, or GitHub PR URL", "minLength": 1, "type": "string"}}, "required": ["urlOrId", "decision"], "type": "object"}, "name": "submit_diff_review"}, {"description": "Update a Linear diff's title, description, reviewer requests, issue links, or status. Provide at least one update. Combined updates can partially succeed; inspect the result before retrying. Use merge_diff to merge and submit_diff_review to approve or request changes.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"addedIssueLinks": {"description": "Add issue links or change the relationship of an existing link", "items": {"additionalProperties": false, "properties": {"issue": {"description": "Linear issue identifier or UUID", "minLength": 1, "type": "string"}, "type": {"description": "Relationship: closes, contributes, links, or reopens", "enum": ["closes", "contributes", "links", "reopens"], "type": "string"}}, "required": ["issue", "type"], "type": "object"}, "maxItems": 25, "minItems": 1, "type": "array"}, "addedReviewRequests": {"description": "Request or re-request reviews; existing pending requests are unchanged", "items": {"anyOf": [{"additionalProperties": false, "properties": {"user": {"description": "Workspace user ID, name, email, or \"me\"", "minLength": 1, "type": "string"}}, "required": ["user"], "type": "object"}, {"additionalProperties": false, "properties": {"externalUserId": {"description": "External user ID from get_diff reviewer metadata", "format": "uuid", "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$", "type": "string"}}, "required": ["externalUserId"], "type": "object"}, {"additionalProperties": false, "properties": {"githubTeamId": {"description": "GitHub team ID from get_diff reviewer metadata", "format": "uuid", "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$", "type": "string"}}, "required": ["githubTeamId"], "type": "object"}]}, "maxItems": 25, "minItems": 1, "type": "array"}, "description": {"description": "New description as Markdown; an empty string clears it", "type": "string"}, "removedIssueLinks": {"description": "Linear issue identifiers or UUIDs to unlink", "items": {"minLength": 1, "type": "string"}, "maxItems": 25, "minItems": 1, "type": "array"}, "removedReviewRequests": {"description": "Withdraw pending review requests; submitted reviews are preserved", "items": {"anyOf": [{"additionalProperties": false, "properties": {"user": {"description": "Workspace user ID, name, email, or \"me\"", "minLength": 1, "type": "string"}}, "required": ["user"], "type": "object"}, {"additionalProperties": false, "properties": {"externalUserId": {"description": "External user ID from get_diff reviewer metadata", "format": "uuid", "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$", "type": "string"}}, "required": ["externalUserId"], "type": "object"}, {"additionalProperties": false, "properties": {"githubTeamId": {"description": "GitHub team ID from get_diff reviewer metadata", "format": "uuid", "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$", "type": "string"}}, "required": ["githubTeamId"], "type": "object"}]}, "maxItems": 25, "minItems": 1, "type": "array"}, "statusAction": {"description": "Status transition to perform after metadata is updated", "enum": ["markReadyForReview", "convertToDraft", "close", "reopen"], "type": "string"}, "title": {"description": "New diff title", "minLength": 1, "type": "string"}, "urlOrId": {"description": "Linear review URL, diff slug, pull request ID, Linear full identifier, or GitHub PR URL", "minLength": 1, "type": "string"}}, "required": ["urlOrId"], "type": "object"}, "name": "update_diff"}, {"description": "Merge a Linear diff or add it to the repository's merge queue", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"mergeMethod": {"description": "Merge method; omit to use the repository default", "enum": ["MERGE", "REBASE", "SQUASH"], "type": "string"}, "urlOrId": {"description": "Linear review URL, diff slug, pull request ID, Linear full identifier, or GitHub PR URL", "minLength": 1, "type": "string"}}, "required": ["urlOrId"], "type": "object"}, "name": "merge_diff"}, {"description": "List or get project/initiative status updates. Pass `id` to get a specific update, or filter to list.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"createdAt": {"description": "Created after: ISO-8601 date/duration (e.g., -P1D)", "type": "string"}, "cursor": {"description": "Next page cursor", "type": "string"}, "id": {"description": "Status update ID - if provided, returns this specific update", "type": "string"}, "includeArchived": {"default": false, "description": "Include archived items", "type": "boolean"}, "initiative": {"description": "Initiative name, ID, identifier (e.g., I-123), or slug", "type": "string"}, "limit": {"default": 50, "description": "Max results (default 50, max 250)", "maximum": 250, "type": "number"}, "orderBy": {"default": "updatedAt", "description": "Sort: createdAt | updatedAt", "enum": ["createdAt", "updatedAt"], "type": "string"}, "project": {"description": "Project name, ID, identifier (e.g., P-ENG-123), or slug", "type": "string"}, "type": {"description": "Type of status update", "enum": ["project", "initiative"], "type": "string"}, "updatedAt": {"description": "Updated after: ISO-8601 date/duration (e.g., -P1D)", "type": "string"}, "user": {"description": "User ID, name, email, or \"me\"", "type": "string"}}, "required": ["type"], "type": "object"}, "name": "get_status_updates"}, {"description": "Create or update a project/initiative status update. Omit `id` to create, provide `id` to update.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"body": {"description": "Content as Markdown. Do not escape the string \u2014 use literal newlines and special characters, not escape sequences. To mention a user, use @displayName (e.g., @johndoe)", "type": "string"}, "health": {"description": "onTrack | atRisk | offTrack", "enum": ["onTrack", "atRisk", "offTrack"], "type": "string"}, "id": {"description": "Status update ID - if provided, updates this existing update", "type": "string"}, "initiative": {"description": "Initiative name, ID, identifier (e.g., I-123), or slug", "type": "string"}, "isDiffHidden": {"description": "Deprecated. Hide diff with previous update (create only)", "type": "boolean"}, "project": {"description": "Project name, ID, identifier (e.g., P-ENG-123), or slug", "type": "string"}, "type": {"description": "Type of status update", "enum": ["project", "initiative"], "type": "string"}}, "required": ["type"], "type": "object"}, "name": "save_status_update"}, {"description": "Delete (archive) a project or initiative status update.", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"id": {"description": "Status update ID", "type": "string"}, "type": {"description": "Type of status update", "enum": ["project", "initiative"], "type": "string"}}, "required": ["type", "id"], "type": "object"}, "name": "delete_status_update"}], "type": "mcp_list_tools"}, "output_index": 2, "sequence_number": 8, "type": "response.output_item.done"}, "topic": "events"}

data: {"perplexity": {"name": "pplx_sdk", "sequence_number": 11, "type": "response.skill.loaded"}, "topic": "events"}

