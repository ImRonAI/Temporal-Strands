    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
