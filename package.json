{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "dev:all": "pnpm dev:clean && concurrently --kill-others --names temporal,worker,api,web -c magenta,yellow,cyan,green \"pnpm dev:temporal\" \"pnpm dev:worker\" \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:temporal": "temporal server start-dev",
    "dev:worker": "wait-on -t 60000 tcp:127.0.0.1:7233 && cd orchestrator && .venv/bin/python -u run_worker.py",
    "dev:api": "wait-on -t 60000 tcp:127.0.0.1:7233 && cd orchestrator && .venv/bin/python -u -m uvicorn server:app --port 8787",
    "dev:web": "wait-on -t 120000 http-get://127.0.0.1:8787/health && next dev",
    "dev:clean": "bash scripts/free-ports.sh"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.210",
    "@base-ui/react": "^1.5.0",
    "@radix-ui/react-use-controllable-state": "^1.2.3",
    "@rive-app/react-webgl2": "^4.29.5",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@vercel/analytics": "1.6.1",
    "@xyflow/react": "^12.11.2",
    "ai": "^6.0.208",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.16.0",
    "media-chrome": "^4.19.2",
    "motion": "^12.42.2",
    "nanoid": "^5.1.11",
    "next": "16.2.6",
    "openai": "^6.48.0",
    "react": "^19",
    "react-dom": "^19",
    "react-jsx-parser": "^2.4.1",
    "shadcn": "^4.8.0",
    "shiki": "^4.3.1",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.3.1",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "typescript": "5.7.3",
    "wait-on": "^9.1.0"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.25"
    }
  }
}
